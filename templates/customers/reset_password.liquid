<div class="shop-wrap">
  <div class="form-card">
    <h1 style="font-size:26px">Reset password</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="New password" autocomplete="new-password" required>
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required>
      <button type="submit" class="prod-buy" style="margin-top:4px">Reset password</button>
    {% endform %}
  </div>
</div>
