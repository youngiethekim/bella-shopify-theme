{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'bella-fonts' %}
  {{ 'bella.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="shop-wrap shop-narrow" style="text-align:center;padding-top:14vh">
    <p class="micro">{{ shop.name }}</p>
    <h1>Opening soon.</h1>
    <p class="rte">We're putting the furniture in place. Check back shortly.</p>
    <div class="form-card" style="margin-top:30px">
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <input type="password" name="password" placeholder="Password">
        <button type="submit" class="prod-buy" style="margin-top:4px">Enter</button>
      {% endform %}
    </div>
  </div>
</body>
</html>
