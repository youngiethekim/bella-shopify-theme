    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "How does the pricing work?",
            "answer": "Each tour is {price:360-virtual-tour-staging|Tour setup & stitching} for stitching, assembly and setup, plus {price:360-virtual-tour-staging|Staged 360° photo} per staged 360° photo (one per room). A typical 8-room listing is $179 all-in. Add the tour setup to your order first, then switch to 'Staged 360° photo' and add one per room."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "What camera do I need?",
            "answer": "Any consumer 360 camera — Ricoh Theta, Insta360 or similar — or your photographer's rig. Shoot one panorama per room from the centre at chest height and upload the files straight off the camera."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Where can I use the tour?",
            "answer": "Anywhere a link works: the MLS's virtual-tour field, Zillow, Realtor.com, your website, email and social. You also receive the staged panorama files themselves, so you can load them into any tour platform you already use."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Is the staging MLS-compliant?",
            "answer": "Yes, with disclosure — the same rule as virtually staged photos. Every staged room is clearly disclosed as digitally staged, and we tell you exactly what to note on the listing."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "How is this different from a Matterport tour?",
            "answer": "A Matterport-style tour is a 3D scan shot by a crew with proprietary hardware, typically $300–500 per listing plus monthly hosting — and it shows the home exactly as it is, empty rooms included. Our tour is built from your own 360 photos, costs a fraction as much, and every room comes virtually staged."
          }
        }
