    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Do these work for StreetEasy and the REBNY listing feed?",
            "answer": "Yes. Files come back at standard dimensions and upload wherever you syndicate. We include disclosure wording and recommend noting virtual staging on the listing."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "My co-op won't approve a physical stage. Is this an alternative?",
            "answer": "It's the usual reason NYC agents call us. There's no elevator booking, no certificate of insurance, no board approval and no crew in the building — the staging happens to the photos, so building rules never enter into it."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Will you make the rooms look bigger than they are?",
            "answer": "No. We furnish to scale, deliberately. Oversized furniture that makes a second bedroom look roomy just moves the disappointment to the showing, and in a market where buyers are measuring for a queen bed, that costs you the deal."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "How does the cost compare to staging a Manhattan listing physically?",
            "answer": "It's the widest gap of any market we work in. Physical staging here carries furniture rental plus building logistics; virtual staging is {price:virtual-staging} a photo with none of the overhead."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "How much does it cost to virtually stage a house?",
            "answer": "Bella virtual staging is {price:virtual-staging} per photo, with volume discounts of 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+. Furniture removal, unlimited revisions for two weeks and full usage rights are included, with no subscription and no minimum. Physical staging generally runs $2,000–5,000 a month."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "How many photos should I stage?",
            "answer": "Stage the rooms buyers decide on: the living room, the primary bedroom and any room whose scale or use isn't obvious. For a typical apartment that is often three to six photos; volume discounts start at three."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "What is the best virtual staging program?",
            "answer": "It depends on the listing. AI apps are fast and cheap but generate furniture automatically, and poorly scaled furniture is a real risk in small NYC rooms. For listings where accuracy matters, a virtual staging service where a designer composes each room in Photoshop, 3D Max and Corona is the safer choice — that is how Bella works."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging worth it?",
            "answer": "For most vacant NYC apartments, yes. Staging can't guarantee a sale, but 97% of buyers use the internet in their home search (NAR), and in New York the photos decide which showings get booked. Virtual staging furnishes them for a one-time cost per photo, with no building logistics."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging legal in New York?",
            "answer": "Yes, as long as the photos aren't misleading. Add furniture and decor only, don't hide defects or change permanent features, and clearly disclose that images are virtually staged — the NAR Code of Ethics and New York advertising rules both expect honest marketing. Every Bella order includes disclosure guidance."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "question": "How can I virtually stage my home for free?",
            "answer": "Free AI apps can place furniture in a photo, but the results are generated rather than designed. New Bella clients can claim a $40 voucher on our sign-up page to try designer staging. Eligibility subject to Bella's approval."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "question": "What do you need from me to start?",
            "answer": "Wide, high-resolution photos of each room, shot in good light. If you have a floor plan, send it along — it helps the designer confirm scale in tight rooms. Tell us the target buyer and a style, or let the designer choose."
          }
        }
      },
