    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "When do I send my photos?",
            "answer": "After checkout. Your order confirmation includes an upload link, so you can order now and send the photos whenever they're ready — nothing is needed up front."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How much does virtual staging cost?",
            "answer": "From {price:virtual-staging} per photo, with volume discounts up to 20%: 5% at three photos, 10% at six, 15% at eleven, and 20% at twenty-one — the best value. A typical six-photo listing runs about $243 with the volume discount applied."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How long does it take?",
            "answer": "24 to 48 hours from the moment you upload, with unlimited revisions free for two weeks and a rework-or-refund guarantee."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Is it allowed on the MLS?",
            "answer": "Yes. Virtually staged photos are widely used on the MLS as long as they're disclosed as virtually staged. We build every image to MLS specifications and tell you exactly what to note."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can you stage occupied or cluttered rooms?",
            "answer": "Yes, at no extra charge. Furniture removal is included free — we digitally clear the existing furniture first, then stage the empty room."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "Can you also fix walls, floors or other items?",
            "answer": "Yes — that's our Virtual Renovation service. We digitally modernize walls, floors and fixtures, then stage the room, from {price:virtual-renovation-service} a photo. Order it from the Virtual Renovation page."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Why Bella over cheaper services?",
            "answer": "Quality over quantity. Every photo is composed by hand by a professional interior designer and carefully finished — we believe higher-quality images bring more buyers to the listing and help it sell at a higher price. And with unlimited revisions and a rework-or-refund guarantee, you're never stuck with an image you can't use."
          }
        },
        "q0": {
          "type": "qa",
          "settings": {
            "question": "What is virtual staging?",
            "answer": "Virtual staging digitally furnishes photos of an empty (or cluttered) room so buyers can see it as a home. At Bella, a real interior designer places photorealistic furniture and decor in your listing photos — no truck, no rental furniture, and the result is MLS-ready in 24–48 hours."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "Does virtual staging help sell a house?",
            "answer": "Yes — staging exists because buyers struggle to picture empty rooms. NAR reports 82% of buyers' agents say staging makes it easier for buyers to visualize a property as their future home, and staged listings consistently earn more saves and showings in the critical first days on market."
          }
        }
      },
