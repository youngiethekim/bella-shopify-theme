    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What can you change?",
            "answer": "Finishes: flooring, wall colors, countertops, cabinet fronts, lighting and plumbing fixtures. We never change the structure — no moved walls, new windows or doors, or square footage that isn't there."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Is staging included?",
            "answer": "Yes. Every virtually renovated room is also virtually staged with designer furniture at no extra charge, so the photo shows a fully furnished, listing-ready space."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Can I use these photos on the MLS?",
            "answer": "Yes, with disclosure. Virtually renovated photos must be clearly disclosed as digitally altered — label each image, keep the original photo available, and never use a renovation to hide defects. We build every image to MLS specifications and tell you exactly what to note."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "What if I don't like the result?",
            "answer": "Unlimited revisions for two weeks after delivery. If it's still not right, we rework it or refund that photo."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "What is virtual renovation?",
            "answer": "Virtual renovation is a digital edit of a real listing photo that updates the finishes — flooring, wall color, countertops, cabinets, lighting and plumbing fixtures — so buyers see the room as it would look after a remodel. At Bella, a real interior designer does the work by hand and stages the finished room, while the structure stays exactly as it is."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "How much does virtual renovation cost?",
            "answer": "Bella's virtual renovation cost is {price:virtual-renovation-service} per photo, with designer staging and furniture removal included at no additional cost. Orders start at three photos, and volume discounts apply in the cart: 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "How long does a virtual renovation take?",
            "answer": "24–48 hours from upload. After delivery you have two weeks of unlimited free revisions, and if a photo still isn't right, we rework it or refund it."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "What's the difference between virtual renovation and virtual staging?",
            "answer": "Virtual staging adds furniture and decor to an empty room. Virtual renovation goes further: it changes the finishes themselves — floors, walls, counters, cabinets and fixtures — and then stages the room. Choose staging when the finishes are fine, and renovation when dated finishes are the problem."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "Can AI or ChatGPT do a virtual renovation?",
            "answer": "AI tools, including image features in chatbots, can redesign a room photo in seconds, but they often alter walls, windows or proportions, which misrepresents the property. Bella's virtual renovations are done by human designers, so the layout stays true and the image is safe to use on the MLS with disclosure."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "question": "What is the best virtual home renovation app?",
            "answer": "For brainstorming ideas at home, an AI renovation app is a fine place to start. For listing photos that buyers will compare with the real room, a designer-made virtual renovation is the safer choice: realistic finishes, an untouched structure, MLS disclosure guidance and unlimited revisions for two weeks."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "question": "Can you renovate exteriors and outdoor areas?",
            "answer": "Yes. Front exteriors, patios and waterfront outdoor areas can be virtually renovated too — see the before-and-after examples at the top of this page."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "question": "Can I choose the finishes and furniture style?",
            "answer": "Yes. Pick one of our Benjamin Moore-matched palettes, name any colors or finishes in your order notes, or let the designer match your market. For the staging, choose a Look Book style — Contemporary, Modern Farmhouse, Scandinavian, Coastal, Mid-Century Modern, Traditional or Transitional."
          }
        },
        "q13": {
          "type": "qa",
          "settings": {
            "question": "Who owns the renovated photos?",
            "answer": "You do. Every order includes full usage rights, so you can use the images in your listing, marketing and print materials."
          }
        }
      },
