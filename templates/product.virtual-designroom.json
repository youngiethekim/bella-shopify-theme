    "reqs": {
      "type": "bella-reqs",
      "blocks": {
        "rq1": {
          "type": "req",
          "settings": {
            "text": "A photo of the room at least <strong>1,000 pixels</strong> on the long edge. Most phone photos already qualify, and <strong>2,000 × 3,000 px</strong> or larger gives your designer the most detail."
          }
        },
        "rq2": {
          "type": "req",
          "settings": {
            "text": "<strong>Empty or furnished</strong>: both work. Send the room as it is today."
          }
        },
        "rq3": {
          "type": "req",
          "settings": {
            "text": "Shot wide and level at chest height, with as much of the room, its walls and windows in frame as you can."
          }
        },
        "rq4": {
          "type": "req",
          "settings": {
            "text": "Your style, if you have one: <a href=\"/pages/lookbook\">Look Book</a> codes, a style name, or a few words about the look you want. Or leave it to your designer."
          }
        },
        "rq5": {
          "type": "req",
          "settings": {
            "text": "One photo per room or angle. To design multiple rooms, order one photo for each."
          }
        },
