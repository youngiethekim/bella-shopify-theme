    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "How much does virtual staging cost in Texas?",
            "answer": "Bella virtual staging is {price:virtual-staging} per photo anywhere in Texas, with volume discounts of 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+. Furniture removal, unlimited revisions for two weeks and full usage rights are included."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How much does it cost to stage a house in Texas?",
            "answer": "Physical staging is usually a design fee plus monthly furniture rental, and on a vacant home it commonly runs to thousands of dollars before the house sells. Virtual staging costs a fraction of that: a one-time {price:virtual-staging} a photo, whether the home sells in a week or a season."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Can you stage a home that isn't built yet?",
            "answer": "Yes, with 3D rendering. Send CAD or PDF plans and elevations, and our 3D artists build photoreal exterior and interior renders from {price:3d-rendering-service-for-architectural-visualization} a view, so you can pre-sell from plans. Once the home is built and photographed, virtual staging furnishes the real photos."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "Will the photos upload to HAR, NTREIS, Unlock MLS and LERA MLS?",
            "answer": "Yes. Files come back at standard MLS dimensions, ready to post in Houston (HAR.com), Dallas–Fort Worth (NTREIS), Austin (Unlock MLS) and San Antonio (LERA MLS). Check your MLS rules for exact labeling; every order includes disclosure guidance."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging legal in Texas?",
            "answer": "Yes. Virtual staging is a standard marketing practice. The rule is not to misrepresent the property: add furniture and decor only, don't hide defects or change permanent features, and disclose that photos are virtually staged, as the NAR Code of Ethics expects."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "Can you stage every home in a community the same way?",
            "answer": "Yes. Send your furniture-layout references and chosen style once, and our designers apply them across every spec home in the release. Highland Homes' team works this way for its Texas communities: kitchen, primary bedroom, living and dining, and study in every home."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Which rooms should a builder stage?",
            "answer": "Start with the rooms buyers weigh most. In NAR's 2025 Profile of Home Staging, buyers' agents rated the living room most important to stage (37%), followed by the primary bedroom (34%) and the kitchen (23%). Add a study or flex room when the plan has one, so buyers see what it's for."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "How much should a 3D rendering cost?",
            "answer": "It depends on the view and the detail. At Bella, photoreal 3D renderings start at {price:3d-rendering-service-for-architectural-visualization} per view, built by human 3D artists from your plans, with revisions included and volume discounts on larger sets."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "Can ChatGPT do architectural renderings?",
            "answer": "AI image tools can generate a picture of a house, but they don't work from your dimensioned plans, so walls, windows and rooflines drift from the real design. For a home you will actually build, Bella's renders are modelled by human 3D artists from your drawings."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "question": "Is AI virtual staging legit for new construction?",
            "answer": "AI apps are quick and cheap, but they guess at scale and often repeat the same room. Bella never uses AI: a designer builds each room by hand, so the furniture fits the actual floor plan and buyers aren't surprised at the walkthrough."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "question": "How can I try virtual staging for free?",
            "answer": "Free AI apps exist, but builders marketing real inventory usually want designer work. New Bella clients can claim a $40 voucher on our sign-up page to try Bella on a first home. Eligibility subject to Bella's approval."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "question": "Do you work across all of Texas?",
            "answer": "Yes. We work online, so builders in Houston, Austin, Dallas–Fort Worth, San Antonio and everywhere in between get the same 24 to 48 hour delivery. We also work across the US and Canada."
          }
        }
      },
