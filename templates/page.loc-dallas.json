        "q7": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging worth it?",
            "answer": "For most vacant Dallas listings, yes. Staging can't guarantee a sale, but 97% of buyers use the internet in their home search (NAR), so the photos are the first showing. Virtual staging furnishes those photos for a one-time cost per photo instead of monthly rental."
          }
