    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Every house in this Frisco development looks the same. Can staging differentiate mine?",
            "answer": "That's the strongest case for it in DFW. When a buyer has already scrolled three identical empty versions of the same floor plan, the staged one reads as somewhere to live rather than a plan number."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Will these upload to NTREIS?",
            "answer": "Yes. Files come back at standard MLS dimensions and specs, ready to post. Disclosure wording is included and we recommend noting virtual staging in the remarks on every listing."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Most of my buyers are relocating and haven't seen the house. Does staging help?",
            "answer": "It's most of what they're judging on. A buyer moving from California on a corporate timeline builds their shortlist online and books one trip — listings that photograph as furnished homes make that list."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "I'm a builder with eight vacant homes. Is there volume pricing?",
            "answer": "Yes, discounts scale to 20% across a set, and builder inventory is quoted as a batch and delivered together. There's also no rental period to extend if a home sits, which is the usual problem with staging spec inventory physically."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "How much does virtual staging cost in Dallas?",
            "answer": "Bella virtual staging is {price:virtual-staging} per photo anywhere in Dallas–Fort Worth, with volume discounts of 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+. Furniture removal, unlimited revisions for two weeks and full usage rights are included. Physical staging, by comparison, generally runs $2,000–5,000 a month."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "How much do people charge for virtual staging?",
            "answer": "It depends on who does the work. AI apps generate a room automatically for a small fee; designer services charge per photo for a room composed by hand. Bella is the second kind, at {price:virtual-staging} a photo with no subscription and no minimum."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging worth it?",
            "answer": "For most vacant Dallas listings, yes. Staging can't guarantee a sale, but 97% of buyers use the internet in their home search (NAR), so the photos are the first showing. Virtual staging furnishes those photos for a one-time cost per photo instead of monthly rental."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging legal in Texas?",
            "answer": "Yes. Virtual staging is a standard marketing practice; the rule is not to misrepresent the property. Add furniture and decor only, don't hide defects or change permanent features, and disclose that photos are virtually staged — the NAR Code of Ethics expects it. Check NTREIS rules for exact labeling; every Bella order includes disclosure guidance."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "What do realtors use for virtual staging?",
            "answer": "Realtors generally choose between do-it-yourself AI apps and done-for-you services. Bella is done-for-you: you upload photos and an interior designer builds each room by hand, so the furniture is sized to the actual room and the photo holds up when buyers walk in."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "question": "What photos do I need for virtual staging?",
            "answer": "High-resolution, well-lit photos of each room, shot wide from a corner. Empty rooms are ideal, but occupied rooms work too because furniture removal is included. The better the original photo, the more realistic the virtually staged photo."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "question": "Can you stage a room for a different use?",
            "answer": "Yes. Virtual staging can show more than one potential use of a space — a Frisco bonus room as a home office, a game room or a nursery — so buyers see what the room can do for them. Tell your designer which use suits the target buyer."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "question": "Do you stage Fort Worth and the suburbs too?",
            "answer": "Yes. We work online, so listings anywhere in DFW — Plano, Frisco, McKinney, Allen, Arlington, Fort Worth and beyond — get the same 24 to 48 hour delivery. We also work across the US and Canada."
          }
        },
        "h1": {
          "type": "qa",
          "settings": {
            "question": "Do you work with Dallas home builders?",
            "answer": "Yes. Highland Homes, a Texas home builder, is a Bella client. Builders across DFW use Bella for new construction virtual staging on spec homes and quick move-ins, model home staging for floor plans without a model, and 3D renderings to pre-sell from plans."
          }
        },
        "h2": {
          "type": "qa",
          "settings": {
            "question": "Can you stage a home that isn't finished yet?",
            "answer": "Virtual staging works on photos of finished or nearly finished rooms. For homes that aren't built yet, a 3D rendering from your plans shows the finished interior or exterior before construction is complete, from {price:3d-rendering} an image."
          }
        },
        "h3": {
          "type": "qa",
          "settings": {
            "question": "How much should a 3D rendering cost?",
            "answer": "At Bella, photoreal 3D renderings start at {price:3d-rendering} per finished image — one room or building from one camera angle — and exteriors are priced by scope. Studios price by complexity, so compare what one image includes before you compare prices."
          }
        }
