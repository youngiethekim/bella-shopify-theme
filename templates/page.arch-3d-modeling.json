    "compare": {
      "type": "bella-included",
      "settings": {
        "eyebrow": "Rendering vs photography",
        "heading": "3D product rendering vs traditional product photography",
        "text": "Product photography needs a finished product, a photography studio, a set and a crew. 3D product rendering needs accurate information about the product. Here is how the two compare for furniture."
      },
      "blocks": {
        "c1": {
          "type": "item",
          "settings": {
            "icon": "image",
            "title": "No samples, sets or shipping",
            "text": "A shoot needs physical samples shipped to a studio, a set built around them and a crew booked. A render needs photos, dimensions and material swatches, so no product has to travel."
          }
        },
        "c2": {
          "type": "item",
          "settings": {
            "icon": "clock",
            "title": "Show it before it's made",
            "text": "Furniture manufacturers and retailers use 3D rendering to show designs before they are physically produced, which cuts the need for costly physical prototypes and lets marketing materials be ready for product launches (<a href=\"https://blog.chaos.com/3d-furniture-rendering-everything-you-need-to-know\" target=\"_blank\" rel=\"noopener\">Chaos</a>)."
          }
        },
        "c3": {
          "type": "item",
          "settings": {
            "icon": "swatch",
            "title": "Every colour way from one model",
            "text": "Photography shoots each finish separately. With a 3D model, a new fabric or wood finish is a material change on the model rather than a reshoot, so wide option ranges stay practical."
          }
        },
        "c4": {
          "type": "item",
          "settings": {
            "icon": "check",
            "title": "One look across the catalogue",
            "text": "Lighting, camera angles and shadows can be matched across every product, supplier and season, so a growing range keeps one visual identity in print ads, on social media and on your website without sacrificing quality."
          }
        },
        "c5": {
          "type": "item",
          "settings": {
            "icon": "sun",
            "title": "Change the room, not the product",
            "text": "A lifestyle scene can be restyled for a new season, market or campaign by changing the room around the model, without building a new physical set."
          }
        },
        "c6": {
          "type": "item",
          "settings": {
            "icon": "eye",
            "title": "When traditional photography still makes sense",
            "text": "For a one-off hero shot of a product already in your warehouse, a good photographer is still a fine choice. Rendering earns its place when the range is wide, the options are many or the product doesn't exist yet."
          }
        }
      },
      "block_order": [
