    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What do you need from me?",
            "answer": "Floor plans or architectural drawings, plus any elevations, material selections and reference images you have. Rough or hand-drawn plans are fine — we confirm anything unclear before modelling."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can I order interior and exterior renders together?",
            "answer": "Yes. Add your interior renders to the order, then switch the render type and add your exteriors — each type shows as its own line in the same order and checks out together."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "What counts as one render?",
            "answer": "One finished image: a single room or building from a single camera angle. Open-plan interiors up to 1,000 sq ft count as one room, and single-building exteriors cover homes up to 6,000 sq ft. Another angle of the same space is a second render — volume discounts apply automatically."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How long does a render take?",
            "answer": "It depends on scope — we confirm timing as soon as you send your plans, and interiors are typically faster than multi-building exteriors."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Are revisions included?",
            "answer": "Yes. You review a draft and mark up changes to composition, materials and lighting, and we revise until it's right."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "What files do I get?",
            "answer": "High-resolution, print-ready images sized for marketing, MLS and hoarding/billboard use on request."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "How much does 3D rendering cost?",
            "answer": "At Bella, photoreal renders start at {price:3d-rendering-service-for-architectural-visualization} per finished image — one room or building from one camera angle, with revisions and 4K print-ready delivery included, and volume discounts up to 20%. For comparison, architects and boutique studios commonly charge $1,000–3,000+ per view for the same photoreal quality."
          }
        }
      },
