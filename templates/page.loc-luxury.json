    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What is luxury virtual staging?",
            "answer": "Luxury virtual staging is virtual staging for high-end homes: an interior designer digitally adds furniture, art, rugs and lighting to photos of empty or cleared rooms, chosen and scaled for the architecture and the buyer the home will attract. The goal is a photo a luxury buyer can't tell was staged until they read the disclosure."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Is there a separate price for luxury or premium virtual staging?",
            "answer": "No. Bella has one tier: the same designers and the same {price:virtual-staging} a photo for a studio rental or a penthouse, with volume discounts of 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How much does it cost to stage a luxury home?",
            "answer": "Physical staging for a luxury home typically runs thousands of dollars a month in furniture rental, design and installation, and more for large homes or long listing periods. Virtual staging costs {price:virtual-staging} a photo, paid once, so staging eight key rooms costs a fraction of a single month of rental."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "How much does luxury home staging cost in Manhattan?",
            "answer": "Physical luxury staging in Manhattan adds building costs on top of furniture rental: insurance certificates, service elevator time and crews that follow board rules. Luxury virtual staging for a Manhattan listing is {price:virtual-staging} a photo with no building logistics at all."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Does virtual staging work for high-end listings?",
            "answer": "Yes, when a designer does it. Luxury buyers notice floating furniture, wrong shadows and pieces that are too small for the room, so high-end virtual staging has to be composed by hand. Done well, it shows scale and lifestyle in rooms that would otherwise photograph as empty space."
          }
        },
        "q6": {
