    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What does it cost?",
            "answer": "{price:virtual-staging} per photo, with volume discounts that scale to 20%: 5% at three photos, 10% at six to ten, 15% at ten to twenty, and 20% at twenty-one to thirty. No subscription, no minimum, no monthly rental."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Can I use these photos on the MLS?",
            "answer": "Yes. Every image is built to MLS specifications and AB 723 disclosure standards. We always recommend disclosing that photos were virtually staged on your public listing and marketing materials, and we tell you exactly what to note. Check your local real estate board for any additional requirements."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Is this AI?",
            "answer": "No. That is the entire point. Every Bella image is composed by hand by a professional interior designer using Photoshop, 3D Max, Corona, and our own internal tools. We do not use AI staging or templates, because they misrepresent properties and produce the same room on every listing in your market."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "How fast do I get my photos back?",
            "answer": "24 to 48 hours from the moment you upload, not the one to two weeks it typically takes to schedule a physical stage."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "What if I don't like the result?",
            "answer": "You get unlimited revisions for two weeks after delivery. If it is still not right, we rework it or refund it. You are not stuck with an image you cannot use."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "The room isn't empty. Can you still stage it?",
            "answer": "Yes. Furniture removal is included: we digitally clear cluttered, tenant-occupied, or mid-renovation rooms before staging them. Send us what you have."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Where do you work?",
            "answer": "Most of our work is with agents, brokerages, and builders across the United States and Canada, and we take listings internationally on request."
          }
        }
      },
