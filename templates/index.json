    "faq": {
      "type": "bella-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "How much do your virtual staging services cost?",
            "answer": "Virtual staging is {price:virtual-staging} per photo, with automatic volume discounts: 5% off 3 or more photos, 10% off 6 or more, 15% off 11 or more and 20% off 21 or more. The same discounts apply to virtual renovation, photo editing, floor plans, 3D rendering and 360° tours in the same order. No subscription, no minimum, no monthly rental."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Can I use these photos on the MLS?",
            "answer": "Yes. Every image is built to MLS specifications and AB 723 disclosure standards. We always recommend disclosing that photos were virtually staged on your public listing and marketing materials, and we tell you exactly what to note. Check your local real estate board for any additional requirements."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Is this AI virtual staging?",
            "answer": "No. That is the entire point. Every Bella image is composed by hand by a professional interior designer using Photoshop, 3D Max, Corona, and our own internal tools. We do not use AI staging or templates, because they misrepresent properties and produce the same room on every listing in your market."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "How fast do I get my photos back?",
            "answer": "24 to 48 hours from the moment you upload, not the one to two weeks it typically takes to schedule a physical stage."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "What if I don't like the result?",
            "answer": "You get unlimited revisions for two weeks after delivery. If it is still not right, we rework it or refund it. You are not stuck with an image you cannot use."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "The room isn't empty. Can you still stage it?",
            "answer": "Yes. Furniture removal is included: we digitally clear cluttered, tenant-occupied, or mid-renovation rooms before staging them. Send us what you have."
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "question": "Where do you work?",
            "answer": "Most of our work is with agents, brokerages, and builders across the United States and Canada, and we take listings internationally on request."
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "question": "Is virtual staging worth it?",
            "answer": "For most vacant homes, yes. 97% of buyers start their search online, and 82% of buyers' agents say staging makes it easier for buyers to visualize a property as their future home, according to the National Association of Realtors. Virtual staging gives your listing photos that effect for a one-time cost per photo, while physical staging runs thousands of dollars a month."
          }
        },
        "q9": {
          "type": "qa",
          "settings": {
            "question": "How is virtual staging different from traditional home staging?",
            "answer": "Traditional home staging rents real furniture into the property and can cost thousands of dollars a month for as long as it's on the market. Virtual staging adds furniture digitally to your listing photos, so there are no movers and no monthly rental, and the staged images are yours for the whole listing. We always recommend disclosing virtually staged photos on the listing."
          }
        },
        "q10": {
          "type": "qa",
          "settings": {
            "question": "What furniture styles can I choose?",
            "answer": "Pick a style from our Look Book, including contemporary, modern farmhouse, Scandinavian, coastal, mid-century modern, and traditional or transitional. Or tell us who you're selling to and a designer chooses furniture styles for your target buyer."
          }
        },
        "q11": {
          "type": "qa",
          "settings": {
            "question": "How many photos should I virtually stage?",
            "answer": "One per room or angle you want buyers to see furnished. Most listings need 5–8 staged photos, starting with the living room, kitchen, dining room and primary bedroom."
          }
        },
        "q12": {
          "type": "qa",
          "settings": {
            "question": "Can I try Bella's virtual staging for free?",
            "answer": "Yes. Real estate professionals can claim a $40 voucher on our free sample page to try Bella virtual staging risk-free. Eligibility is subject to Bella's approval."
          }
        }
      },
