        "q1": {
          "type": "qa",
          "settings": {
            "question": "How much does virtual staging cost in Toronto?",
            "answer": "Bella virtual staging is {price:virtual-staging} per photo, with volume discounts of 5% at 3+ photos, 10% at 6+, 15% at 11+ and 20% at 21+. Furniture removal for occupied rooms, unlimited revisions for two weeks and full usage rights are included — no subscription and no minimum."
          }
