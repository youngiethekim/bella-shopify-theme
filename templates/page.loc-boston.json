          "settings": {
            "question": "My listing is a triple-decker with a tenant still in it. Can you stage that?",
            "answer": "Yes. Furniture removal is included, so we digitally clear the tenant's belongings first and then stage the room clean. You don't need a vacancy or an awkward conversation to get usable photos."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Will these upload to MLS PIN?",
            "answer": "Yes — files come back at standard MLS dimensions and file specs. We also include disclosure wording; noting that photos are virtually staged in the remarks is standard practice and we recommend it on every listing."
          }
