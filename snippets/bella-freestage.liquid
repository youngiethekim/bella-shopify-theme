{%- liquid
  assign fs_staging = settings.product_staging | default: all_products['virtual-staging-1']
  assign fs_rendering = settings.product_rendering | default: all_products['3d-rendering']
  assign fs_order_url = settings.assistant_order_url | default: fs_staging.url | default: routes.all_products_collection_url
-%}
<div class="fs-back" id="fsBack" role="dialog" aria-modal="true" aria-label="Free sample visualization offer">
  <div class="fs-modal">
    <div class="fs-vis" id="fsVis">
      {%- comment -%}
        This dialog starts hidden and many visitors never open it, so both images
        load lazily and at a size that fits the modal rather than full-resolution.
      {%- endcomment -%}
      {% render 'bella-image', image: settings.freestage_before, asset: 'hero-before.jpg', class: 'fs-before', alt: 'Empty room', width: 1200, height: 800, sizes: '(max-width: 760px) 94vw, 620px' %}
      {% render 'bella-image', image: settings.freestage_after, asset: 'hero-after.jpg', class: 'fs-after', alt: 'Same room, staged', width: 1200, height: 800, sizes: '(max-width: 760px) 94vw, 620px' %}
      <span class="fs-tag" id="fsTag">Before</span>
    </div>
    <div class="fs-body">
      <button class="fs-x" id="fsX" aria-label="Close">&times;</button>
      <div id="fsForm">
        <div class="fs-eyebrow">For agents, brokers & builders · You may be eligible</div>
        <h3>Get one free <em>visualization.</em></h3>
        <p class="sub">You may be eligible for a free sample — a staged photo of your listing, or a sample visualization of your project — emailed back within 24 hours, watermark-free. See how much better it sells before you spend a dollar.</p>
        {%- form 'contact', id: 'fsFm' -%}
          <input class="fs-field" type="email" id="fsEmail" name="contact[email]" placeholder="Work email" required>
          <select class="fs-field" id="fsRole" name="contact[role]" required aria-label="I'm a…">
            <option value="" disabled selected>I'm a…</option>
            <option value="agent">Real estate agent</option>
            <option value="broker">Broker / team lead</option>
            <option value="builder">Home builder / developer</option>
            <option value="photographer">Real estate photographer</option>
            <option value="notpro">Not a real estate professional</option>
          </select>
          <input type="hidden" name="contact[body]" value="Free sample visualization signup from the website popup.">
          <button class="fs-sub" type="submit">Claim my free sample →</button>
        {%- endform -%}
        <p class="fs-fine">This promotion is for real estate professionals, builders and developers only; we reserve the right to verify eligibility or decline. One free sample each. We'll never share your email. Staging {% render 'bella-price', product: fs_staging, prefix: 'from', suffix: 'a photo' %} · 3D renders {% render 'bella-price', product: fs_rendering, prefix: 'from' %}. Reply to our confirmation email with your photo or plans.</p>
      </div>
      <div class="fs-ok" id="fsGate" style="display:none">
        <div class="chk">🏠</div>
        <h3>This free sample is for real estate pros.</h3>
        <p>Selling your own home? Your listing agent can claim the free room for you. Or stage your listing directly — real designer staging {% render 'bella-price', product: fs_staging, prefix: 'from', suffix: 'a photo' %}.</p>
        <a class="go" href="{{ fs_order_url }}">Stage a listing → {% render 'bella-price', product: fs_staging %}/photo</a>
      </div>
    </div>
  </div>
</div>
