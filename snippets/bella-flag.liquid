{%- comment -%}
  A country flag as inline SVG, looked up by ISO code.

  Emoji flags are not an option here: Windows ships no glyphs for the regional
  indicator pairs, so 🇨🇦 renders as the letters "CA" and the control looks
  broken on the machines most of this shop's buyers use. Any country without a
  drawing below falls back to its ISO code in a pill, which is honest and
  always renders.

  Accepts: code (ISO 3166-1 alpha-2), size (px, default 18)
{%- endcomment -%}
{%- liquid
  assign c = code | upcase
  assign w = size | default: 18
  assign h = w | times: 3 | divided_by: 4
-%}
{%- case c -%}
  {%- when 'US' -%}
    <svg class="flag" viewBox="0 0 24 18" width="{{ w }}" height="{{ h }}" role="img" aria-hidden="true" focusable="false">
      <rect width="24" height="18" fill="#fff"/>
      <g fill="#b22234"><rect width="24" height="1.4" y="0"/><rect width="24" height="1.4" y="2.8"/><rect width="24" height="1.4" y="5.6"/><rect width="24" height="1.4" y="8.4"/><rect width="24" height="1.4" y="11.2"/><rect width="24" height="1.4" y="14"/><rect width="24" height="1.4" y="16.6"/></g>
      <rect width="10" height="9.8" fill="#3c3b6e"/>
    </svg>
  {%- when 'CA' -%}
    <svg class="flag" viewBox="0 0 24 18" width="{{ w }}" height="{{ h }}" role="img" aria-hidden="true" focusable="false">
      <rect width="24" height="18" fill="#fff"/>
      <rect width="6" height="18" fill="#d52b1e"/><rect width="6" height="18" x="18" fill="#d52b1e"/>
      <path fill="#d52b1e" d="M12 4.2l.9 1.9 2-.5-.7 1.9 1.6 1-1.6.6.4 1.9-1.8-.6-.5 2.1h-.6l-.5-2.1-1.8.6.4-1.9L8.2 8.5l1.6-1-.7-1.9 2 .5z"/>
    </svg>
  {%- when 'GB' -%}
    <svg class="flag" viewBox="0 0 24 18" width="{{ w }}" height="{{ h }}" role="img" aria-hidden="true" focusable="false">
      <rect width="24" height="18" fill="#012169"/>
      <path d="M0 0l24 18M24 0L0 18" stroke="#fff" stroke-width="3.6"/>
      <path d="M0 0l24 18M24 0L0 18" stroke="#c8102e" stroke-width="2.2"/>
      <path d="M12 0v18M0 9h24" stroke="#fff" stroke-width="6"/>
      <path d="M12 0v18M0 9h24" stroke="#c8102e" stroke-width="3.6"/>
    </svg>
  {%- when 'AU' -%}
    <svg class="flag" viewBox="0 0 24 18" width="{{ w }}" height="{{ h }}" role="img" aria-hidden="true" focusable="false">
      <rect width="24" height="18" fill="#012169"/>
      <g transform="scale(.5)">
        <path d="M0 0l24 18M24 0L0 18" stroke="#fff" stroke-width="3.6"/>
        <path d="M12 0v18M0 9h24" stroke="#fff" stroke-width="6"/>
        <path d="M12 0v18M0 9h24" stroke="#c8102e" stroke-width="3.6"/>
      </g>
      <circle cx="17.5" cy="6" r="1.5" fill="#fff"/><circle cx="20" cy="11" r="1.1" fill="#fff"/><circle cx="15" cy="13" r="1" fill="#fff"/>
    </svg>
  {%- else -%}
    <span class="flag flag-code" aria-hidden="true">{{ c }}</span>
{%- endcase -%}
