{%- comment -%}
  Visible FAQ and FAQPage JSON-LD from one source: the custom.faqs JSON metafield
  ([{"q": "...", "a": "..."}]) on a page, product or collection.
  Usage: {% render 'bella-faq-meta', owner: page %}
{%- endcomment -%}
{%- assign faq_items = owner.metafields.custom.faqs.value -%}
{%- if faq_items != blank and faq_items.size > 0 -%}
<section class="faq" id="faq">
  <div class="head" style="padding-left:0;padding-right:0">
    <span class="micro">Questions</span>
    <h2>Frequently asked questions</h2>
  </div>
  <div class="in">
    {%- for item in faq_items -%}
      <details {% if forloop.first %}open{% endif %}>
        <summary>{{ item.q | escape }}</summary>
        <p>{{ item.a | escape }}</p>
      </details>
    {%- endfor -%}
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq_items %}
    {
      "@type": "Question",
      "name": {{ item.q | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
{%- endif -%}
