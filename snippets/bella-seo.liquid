{%- comment -%} Social meta + structured data. Rendered in theme.liquid <head>. {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
{%- assign seo_title = page_title -%}
{%- assign seo_desc = page_description -%}
{%- if request.page_type == 'index' -%}
  {%- assign vs_seo_price = all_products['virtual-staging'].price_min | money_without_trailing_zeros -%}
  {%- assign seo_title = 'Virtual Staging for Real Estate — From ' | append: vs_seo_price | append: ' a Photo | Bella' -%}
  {%- assign seo_desc = 'Designer virtual staging for real estate — MLS-ready in 24–48 hours, from ' | append: vs_seo_price | append: ' a photo. Plus 3D rendering, floor plans, photo editing and 360 tours. Rated 4.9 on Google.' -%}
{%- endif -%}
<meta property="og:title" content="{{ seo_title | escape }}">
{%- if seo_desc %}
<meta property="og:description" content="{{ seo_desc | escape }}">
{%- endif %}
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{%- if seo_desc %}
<meta name="twitter:description" content="{{ seo_desc | escape }}">
{%- endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ shop.secure_url | append: '/#organization' | json }},
  "name": {{ shop.name | json }},
  "alternateName": ["Bella Virtual", "Bella Staging"],
  "url": {{ shop.secure_url | json }},
  {%- if shop.brand.logo %}
  "logo": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }},
  {%- endif %}
  "foundingDate": "2017",
  "description": "Virtual staging, 3D rendering, floor plans, 3D furniture modeling and photo editing — designed by hand, never AI.",
  {%- if settings.company_phone != blank %}
  "telephone": {{ settings.company_phone | strip | json }},
  {%- endif %}
  {%- if settings.company_address != blank %}
  "address": {{ settings.company_address | strip | json }},
  {%- endif %}
  "areaServed": ["United States", "Canada"],
  "knowsAbout": ["Virtual staging", "Virtual renovation", "Virtual furniture removal", "3D architectural rendering", "3D product rendering", "3D furniture modeling", "2D and 3D floor plans", "Real estate photo editing", "360° virtual tours"],
  "sameAs": [
    "https://www.linkedin.com/company/bella-virtual-staging",
    "https://www.facebook.com/bellavirtualstaging",
    "https://www.instagram.com/bella_virtual_staging/",
    "https://www.houzz.com/professionals/interior-designers-and-decorators/bella-virtual-staging-pfvwus-pf~1421584485"
  ]
}
</script>

{%- if request.page_type == 'page' and page %}
{%- liquid
  assign pg_suffix = page.template_suffix | default: ''
  assign pg_service = false
  assign pg_area = ''
  if pg_suffix contains 'loc-'
    assign pg_service = true
    assign pg_area = page.title | remove: 'Virtual Home Staging in ' | remove: 'Virtual Staging in ' | strip
  elsif pg_suffix contains 'arch-' or pg_suffix == 'pricing'
    assign pg_service = true
  elsif page.handle contains 'rendering-services' or page.handle contains '3d-rendering-' or page.handle == '3d-floor-plans' or page.handle == 'real-estate-photo-editing'
    assign pg_service = true
    if page.handle contains '3d-rendering-'
      assign pg_area = page.title | remove: '3D Rendering Services in ' | strip
    endif
  endif

  comment
    Price range for the Service offer, read live from the product a page sells
  endcomment
  assign pg_offer_product = nil
  assign pg_offer_filter = ''
  if pg_suffix contains 'loc-'
    assign pg_offer_product = all_products['virtual-staging']
  elsif page.handle == '3d-floor-plans'
    assign pg_offer_product = all_products['2d-3d-floor-plan-service']
    assign pg_offer_filter = '3D'
  elsif page.handle contains 'interior-rendering'
    assign pg_offer_product = all_products['3d-rendering-service-for-architectural-visualization']
    assign pg_offer_filter = 'Interior'
  elsif page.handle contains 'exterior-rendering'
    assign pg_offer_product = all_products['3d-rendering-service-for-architectural-visualization']
    assign pg_offer_filter = 'Exterior'
  elsif page.handle contains 'rendering' and pg_suffix != 'arch-3d-modeling'
    assign pg_offer_product = all_products['3d-rendering-service-for-architectural-visualization']
  endif
  assign pg_lo = nil
  assign pg_hi = nil
  assign pg_offer_count = 0
  if pg_offer_product
    for v in pg_offer_product.variants
      if pg_offer_filter == blank or v.title contains pg_offer_filter
        if pg_lo == nil
          assign pg_lo = v.price
          assign pg_hi = v.price
        elsif v.price < pg_lo
          assign pg_lo = v.price
        elsif v.price > pg_hi
          assign pg_hi = v.price
        endif
        assign pg_offer_count = pg_offer_count | plus: 1
      endif
    endfor
  endif

  comment
    FAQ block written in the page body (h2 "…Questions…"/"FAQ", then h3 question + answer).
    Templated pages (loc-, arch-, res-) render bella-faq, which outputs its own FAQPage.
  endcomment
  assign pg_faq_seg = ''
  unless pg_suffix contains 'loc-' or pg_suffix contains 'arch-' or pg_suffix contains 'res-'
    assign pg_body_parts = page.content | split: '<h2'
    for part in pg_body_parts
      assign pg_h2 = part | split: '</h2>' | first | prepend: '<h2' | strip_html | downcase
      if pg_h2 contains 'question' or pg_h2 contains 'faq' or pg_h2 contains 'asked'
        assign pg_faq_seg = part
        break
      endif
    endfor
  endunless
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.secure_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ shop.secure_url | append: page.url | json }} }
  ]
}
</script>
{%- if pg_service %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ page.title | json }},
  "url": {{ shop.secure_url | append: page.url | json }},
  {%- if page_description != blank %}
  "description": {{ page_description | json }},
  {%- endif %}
  "provider": { "@id": {{ shop.secure_url | append: '/#organization' | json }} },
  {%- if pg_area != blank and pg_area != page.title %}
  "areaServed": {{ pg_area | json }}
  {%- else %}
  "areaServed": ["United States", "Canada"]
  {%- endif %}
  {%- if pg_offer_count > 0 %},
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": {{ pg_lo | money_without_currency | remove: ',' | json }},
    "highPrice": {{ pg_hi | money_without_currency | remove: ',' | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "offerCount": {{ pg_offer_count }}
  }
  {%- endif %}
}
</script>
{%- endif %}
{%- if pg_faq_seg != blank %}
{%- capture pg_faq_items -%}
  {%- assign pg_faq_n = 0 -%}
  {%- assign pg_qs = pg_faq_seg | split: '<h3' -%}
  {%- for item in pg_qs offset: 1 -%}
    {%- assign pg_q = item | split: '</h3>' | first | prepend: '<h3' | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | split: ' ' | join: ' ' -%}
    {%- unless pg_q contains '?' -%}{%- continue -%}{%- endunless -%}
    {%- assign pg_a = item | split: '</h3>' | last | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | split: ' ' | join: ' ' -%}
    {%- if pg_a == blank -%}{%- continue -%}{%- endif -%}
    {%- if pg_faq_n > 0 -%},{%- endif -%}
    { "@type": "Question", "name": {{ pg_q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ pg_a | json }} } }
    {%- assign pg_faq_n = pg_faq_n | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if pg_faq_n > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{{ pg_faq_items }}]
}
</script>
{%- endif %}
{%- endif %}
{%- endif %}

{%- comment -%} WebSite (with SearchAction) comes from booster-seo.liquid. {%- endcomment -%}

{%- if request.page_type == 'product' and product %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.secure_url | append: product.url | json }},
  {%- if product.featured_image %}
  "image": [{{ product.featured_image | image_url: width: 1400 | prepend: 'https:' | json }}],
  {%- endif %}
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": [
    {%- for variant in product.variants %}
    {
      "@type": "Offer",
      "name": {{ variant.title | json }},
      "price": {{ variant.price | money_without_currency | remove: ',' | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.secure_url | append: product.url | append: '?variant=' | append: variant.id | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.secure_url | json }} },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": {{ shop.secure_url | append: routes.all_products_collection_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.secure_url | append: product.url | json }} }
  ]
}
</script>
{%- endif %}

{%- if request.page_type == 'article' and article %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1400 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | default: shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.secure_url | json }} },
  "mainEntityOfPage": {{ shop.secure_url | append: article.url | json }},
  "url": {{ shop.secure_url | append: article.url | json }}
}
</script>
{%- endif %}
