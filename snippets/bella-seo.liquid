{%- comment -%} Social meta + structured data. Rendered in theme.liquid <head>. {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
{%- assign seo_title = page_title -%}
{%- assign seo_desc = page_description -%}
{%- if request.page_type == 'index' -%}
  {%- assign vs_seo_price = all_products['virtual-staging-1'].price_min | money_without_trailing_zeros -%}
  {%- assign seo_title = 'Virtual Staging for Real Estate — From ' | append: vs_seo_price | append: ' a Photo | Bella' -%}
  {%- assign seo_desc = 'Designer virtual staging for real estate — MLS-ready in 24–48 hours, from ' | append: vs_seo_price | append: ' a photo. Plus 3D rendering, floor plans, photo editing and 360 tours. Rated 4.9 on Google.' -%}
{%- endif -%}
<meta property="og:title" content="{{ seo_title | escape }}">
{%- if seo_desc %}
<meta property="og:description" content="{{ seo_desc | escape }}">
{%- endif %}
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{%- if seo_desc %}
<meta name="twitter:description" content="{{ seo_desc | escape }}">
{%- endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.secure_url | json }},
  "description": "Virtual staging, 3D rendering, floor plans and photo editing for real estate — designed by hand, never AI.",
  "sameAs": []
}
</script>

{%- if request.page_type == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.secure_url | json }}
}
</script>
{%- endif %}

{%- if request.page_type == 'product' and product %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.secure_url | append: product.url | json }},
  {%- if product.featured_image %}
  "image": [{{ product.featured_image | image_url: width: 1400 | prepend: 'https:' | json }}],
  {%- endif %}
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": [
    {%- for variant in product.variants %}
    {
      "@type": "Offer",
      "name": {{ variant.title | json }},
      "price": {{ variant.price | money_without_currency | remove: ',' | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.secure_url | append: product.url | append: '?variant=' | append: variant.id | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.secure_url | json }} },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": {{ shop.secure_url | append: routes.all_products_collection_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.secure_url | append: product.url | json }} }
  ]
}
</script>
{%- endif %}

{%- if request.page_type == 'article' and article %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1400 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | default: shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.secure_url | json }} },
  "mainEntityOfPage": {{ shop.secure_url | append: article.url | json }},
  "url": {{ shop.secure_url | append: article.url | json }}
}
</script>
{%- endif %}
