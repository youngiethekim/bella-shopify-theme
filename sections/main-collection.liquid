{%- liquid
  comment
    Featured service: the picked product, or the first product whose title contains "virtual staging"
  endcomment
  assign featured = section.settings.featured_product
  if featured == blank
    for p in collection.products
      assign t = p.title | downcase
      if t contains 'virtual staging'
        assign featured = p
        break
      endif
    endfor
  endif
-%}
<div class="shop-wrap">
  <p class="micro">{{ section.settings.eyebrow }}</p>
  <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ collection.title }}{% endif %}</h1>
  {%- if collection.description != blank -%}
    <div class="rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- if featured != blank and section.settings.show_featured -%}
    <a class="feat-svc" href="{{ featured.url }}">
      <div class="fs-img">
        {%- if featured.featured_image -%}
          <img src="{{ featured.featured_image | image_url: width: 1200 }}" alt="{{ featured.featured_image.alt | default: featured.title | escape }}" width="1200" height="900">
        {%- endif -%}
      </div>
      <div class="fs-body">
        <p class="micro" style="color:var(--green)">{{ section.settings.featured_eyebrow }}</p>
        <h2>{{ featured.title }}</h2>
        <div class="fs-price">{% if featured.price_varies %}From {% endif %}<b>{{ featured.price_min | money }}</b> / photo</div>
        {%- if section.settings.featured_text != blank -%}
          <p class="fs-desc">{{ section.settings.featured_text }}</p>
        {%- elsif featured.description != blank -%}
          <p class="fs-desc">{{ featured.description | strip_html | truncate: 170 }}</p>
        {%- endif -%}
        <span class="btn">{{ section.settings.featured_cta }}</span>
      </div>
    </a>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
    <div class="other-svcs">
      {%- if section.settings.other_heading != blank -%}
        <p class="micro">{{ section.settings.other_heading }}</p>
      {%- endif -%}
      <div class="coll-grid">
        {%- for product in collection.products -%}
          {%- if featured != blank and product.id == featured.id and section.settings.show_featured -%}
            {%- continue -%}
          {%- endif -%}
          <a class="coll-card" href="{{ product.url }}">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="450">
            {%- endif -%}
            <div class="cc-body">
              <div class="cc-title">{{ product.title }}</div>
              <div class="cc-price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</div>
            </div>
          </a>
        {%- else -%}
          <p class="rte">No services here yet.</p>
        {%- endfor -%}
      </div>
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection (services)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Services" },
    { "type": "text", "id": "heading", "label": "Heading (overrides collection title)", "default": "Our services" },
    { "type": "header", "content": "Featured service" },
    { "type": "checkbox", "id": "show_featured", "label": "Show a featured service", "default": true },
    { "type": "product", "id": "featured_product", "label": "Featured service", "info": "Leave empty to auto-pick the first product with \"virtual staging\" in its title" },
    { "type": "text", "id": "featured_eyebrow", "label": "Featured eyebrow", "default": "Our main service · Most popular" },
    { "type": "textarea", "id": "featured_text", "label": "Featured description (overrides product description)", "default": "Empty rooms furnished by real interior designers, matched to your buyer and market. MLS-ready in 24–48 hours, with unlimited revisions for two weeks." },
    { "type": "text", "id": "featured_cta", "label": "Featured button label", "default": "Order virtual staging →" },
    { "type": "header", "content": "Other services" },
    { "type": "text", "id": "other_heading", "label": "Grid heading", "default": "Other services" }
  ]
}
{% endschema %}
