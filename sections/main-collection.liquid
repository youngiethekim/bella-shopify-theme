<div class="shop-wrap">
  <p class="micro">{{ section.settings.eyebrow }}</p>
  <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ collection.title }}{% endif %}</h1>

  {%- if section.blocks.size > 0 -%}
    <div class="feat-list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <a class="feat-svc{% cycle '', ' flip' %}" href="{{ p.url }}" {{ block.shopify_attributes }}>
            <div class="fs-img">
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 1200 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %} width="1200" height="900">
              {%- endif -%}
            </div>
            <div class="fs-body">
              <p class="micro" style="color:var(--green)">{{ block.settings.eyebrow }}</p>
              <h2>{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ p.title }}{% endif %}</h2>
              <div class="fs-price">{% if p.price_varies %}From {% endif %}<b>{{ p.price_min | money }}</b> / {{ block.settings.unit }}</div>
              {%- if block.settings.text != blank -%}
                <p class="fs-desc">{{ block.settings.text }}</p>
              {%- elsif p.description != blank -%}
                <p class="fs-desc">{{ p.description | strip_html | truncate: 170 }}</p>
              {%- endif -%}
              <span class="btn">{{ block.settings.cta }}</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- paginate collection.products by 24 -%}
      <div class="coll-grid" style="margin-top:28px">
        {%- for product in collection.products -%}
          <a class="coll-card" href="{{ product.url }}">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="450">
            {%- endif -%}
            <div class="cc-body">
              <div class="cc-title">{{ product.title }}</div>
              <div class="cc-price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</div>
            </div>
          </a>
        {%- else -%}
          <p class="rte">No services here yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection (services)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Services" },
    { "type": "text", "id": "heading", "label": "Heading (overrides collection title)", "default": "Our services" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Service card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 · Virtual Staging" },
        { "type": "text", "id": "title", "label": "Title (overrides product title)" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "photo" },
        { "type": "textarea", "id": "text", "label": "Description (overrides product description)" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Order virtual staging →" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Collection (services)" }]
}
{% endschema %}
