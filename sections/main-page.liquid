<div class="shop-wrap shop-narrow">
  {%- unless section.settings.hide_title -%}<h1>{{ page.title }}</h1>{%- endunless -%}
  <div class="rte">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "hide_title", "label": "Hide page title (when the template already has an H1)", "default": false }
  ]
}
{% endschema %}
