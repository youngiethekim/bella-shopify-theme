<article class="shop-wrap shop-narrow">
  <nav class="crumb" aria-label="Breadcrumb" style="padding:0 0 14px">
    <a href="{{ routes.root_url }}">Home</a> ·
    <a href="{{ blog.url }}">{{ blog.title }}</a> ·
    {{ article.title | truncate: 40 }}
  </nav>
  <p class="micro">{{ article.published_at | date: '%B %-d, %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
  <h1>{{ article.title }}</h1>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | default: article.title | escape }}" style="width:100%;border-radius:14px;margin:18px 0 26px" width="1400" height="930">
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>

  {%- if section.settings.show_related -%}
    {%- if blog.articles.size > 1 -%}
      <aside class="art-more">
        <p class="micro">{{ section.settings.related_label }}</p>
        <div class="blog-list" style="margin-top:16px">
          {%- assign shown = 0 -%}
          {%- for a in blog.articles -%}
            {%- if a.id != article.id and shown < 3 -%}
              {%- assign shown = shown | plus: 1 -%}
              <a class="coll-card" href="{{ a.url }}">
                {%- if a.image -%}
                  <img src="{{ a.image | image_url: width: 600 }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy" width="600" height="450">
                {%- endif -%}
                <div class="cc-body">
                  <div class="cc-title">{{ a.title }}</div>
                  <div class="cc-price">{{ a.published_at | date: '%B %-d, %Y' }}</div>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </aside>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_cta -%}
    {%- liquid
      comment
        Match the closing CTA to the article's topic so a rendering guide
        sells renders, a renovation guide sells renovations, and so on.
      endcomment
      assign topic = article.handle | append: ' ' | append: article.title | downcase
      assign cta_url = section.settings.cta_url
      assign cta_heading = section.settings.cta_heading
      assign cta_label = section.settings.cta_label
      if cta_url == blank
        if topic contains 'render' or topic contains 'architect' or topic contains 'builder' or topic contains 'presell' or topic contains 'pre-sell'
          assign cta_product = settings.product_rendering | default: all_products['3d-rendering']
          assign cta_heading = 'Building or pre-selling? Photoreal 3D renders from {price:3d-rendering}.'
          assign cta_label = 'See 3D rendering →'
        elsif topic contains 'renovation' or topic contains 'dated home' or topic contains 'flip'
          assign cta_product = settings.product_renovation | default: all_products['virtual-renovation']
          assign cta_heading = 'Selling a dated home? Renovate it virtually for {price:virtual-renovation} a photo.'
          assign cta_label = 'See virtual renovation →'
        elsif topic contains '360' or topic contains 'house tour' or topic contains 'virtual tour'
          assign cta_product = settings.product_tour | default: all_products['360-virtual-tour-staging']
          assign cta_heading = 'Give buyers the walkthrough — staged 360° tours from {price:360-virtual-tour-staging|Tour setup & stitching}.'
          assign cta_label = 'See 360° tours →'
        elsif topic contains 'floor plan' or topic contains 'floor-plan'
          assign cta_product = settings.product_floorplan | default: all_products['2d-3d-floor-plan-service']
          assign cta_heading = 'Add a floor plan buyers can actually read — from {price:2d-3d-floor-plan-service}.'
          assign cta_label = 'See floor plans →'
        elsif topic contains 'dusk' or topic contains 'twilight' or topic contains 'photo-editing' or topic contains 'item-removal' or topic contains 'hdr' or topic contains 'photography'
          assign cta_product = settings.product_editing | default: all_products['photo-editing']
          assign cta_heading = 'Polish your listing photos — professional edits from {price:photo-editing} a photo.'
          assign cta_label = 'See photo editing →'
        else
          assign cta_product = settings.product_staging | default: all_products['virtual-staging-1']
        endif
        assign cta_url = cta_product.url | default: routes.all_products_collection_url
      endif
    -%}
    <aside class="art-cta">
      <p class="micro">{{ section.settings.cta_eyebrow }}</p>
      <h2>{% render 'bella-copy', text: cta_heading %}</h2>
      <a class="btn" href="{{ cta_url }}">{{ cta_label }}</a>
    </aside>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related articles", "default": true },
    { "type": "text", "id": "related_label", "label": "Related label", "default": "More from the Bella blog" },
    { "type": "checkbox", "id": "show_cta", "label": "Show service CTA", "default": true },
    { "type": "text", "id": "cta_eyebrow", "label": "CTA eyebrow", "default": "While you're here" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Selling a listing? Stage it virtually for {price:virtual-staging-1} a photo.", "info": "Write prices as {price:product-handle} so they follow the product and the visitor's currency." },
    { "type": "url", "id": "cta_url", "label": "CTA link", "info": "Leave empty to match the CTA to the article's topic automatically." },
    { "type": "text", "id": "cta_label", "label": "CTA button", "default": "See virtual staging →" }
  ]
}
{% endschema %}
