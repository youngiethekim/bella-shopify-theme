<section class="value">
  <div class="value-in">
    <p class="micro">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="value-rows">
      <div class="vrow old"><span class="vlbl">{{ section.settings.old_label }}</span><span class="vamt"><s>{{ section.settings.old_amount }}</s></span><span class="vper">{{ section.settings.old_per }}</span></div>
      <div class="vrow new"><span class="vlbl">{{ section.settings.new_label }}</span><span class="vamt">{{ section.settings.new_amount }}</span><span class="vper">{{ section.settings.new_per }}</span></div>
    </div>
    <p class="value-note">{{ section.settings.note }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn-wht" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cost comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The math" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same result. A fraction of the cost." },
    { "type": "text", "id": "old_label", "label": "Row 1 label", "default": "Physical staging" },
    { "type": "text", "id": "old_amount", "label": "Row 1 amount (struck through)", "default": "$2,000–5,000" },
    { "type": "text", "id": "old_per", "label": "Row 1 detail", "default": "a month · until it sells · the furniture goes back" },
    { "type": "text", "id": "new_label", "label": "Row 2 label", "default": "Bella virtual staging" },
    { "type": "text", "id": "new_amount", "label": "Row 2 amount", "default": "$45" },
    { "type": "text", "id": "new_per", "label": "Row 2 detail", "default": "a photo · paid once · yours for the whole listing" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Staging does one job: it shows buyers the full potential of a home. Real furniture or virtual, a staged room sets the scene, fills the space, and lets a buyer imagine themselves living there. Both earn the same reaction in the first three photos, where the click is won or lost. The only real difference is the bill: physical staging runs thousands a month and leaves the day the home sells, while Bella does the same job once, for about a tenth of the cost." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the full comparison →" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Cost comparison" }]
}
{% endschema %}
