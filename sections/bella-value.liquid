{% style %}
.vp{margin-top:26px;border-top:1px solid rgba(255,255,255,.14)}
.vp a{display:grid;grid-template-columns:1.05fr 1fr .9fr auto;gap:10px 20px;align-items:baseline;padding:15px 0;border-bottom:1px solid rgba(255,255,255,.14);text-decoration:none;transition:.15s}
.vp .vp-svc{color:#fff;font-size:15px;letter-spacing:-.005em}
.vp .vp-old{color:#807A72;font-size:13px}
.vp .vp-old s{color:#807A72}
.vp .vp-new{color:#CFC9C0;font-size:13px}
.vp .vp-new b{font-size:18px;font-weight:400;color:#fff;margin-right:5px}
.vp .vp-go{color:#8FA898;font-size:12px;letter-spacing:.05em;white-space:nowrap;justify-self:end}
.vp a:hover .vp-go{color:#fff}
@media(max-width:760px){
  .vp a{grid-template-columns:1fr auto;padding:14px 0}
  .vp .vp-svc{grid-column:1/-1}
  .vp .vp-go{grid-row:2;align-self:baseline}
}
{% endstyle %}
<section class="value">
  <div class="value-in">
    <p class="micro">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- assign pairs = section.blocks | where: 'type', 'pair' -%}
    {%- if pairs.size > 0 -%}
      <div class="vp">
        {%- for block in pairs -%}
          <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            <span class="vp-svc">{{ block.settings.service }}</span>
            <span class="vp-old">{{ block.settings.old_label }} <s>{{ block.settings.old_amount }}</s></span>
            <span class="vp-new"><b>{% render 'bella-copy', text: block.settings.new_amount %}</b>{{ block.settings.new_unit }}</span>
            <span class="vp-go">{{ block.settings.link_label | default: 'See the service →' }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="value-rows">
        <div class="vrow old"><span class="vlbl">{{ section.settings.old_label }}</span><span class="vamt"><s>{{ section.settings.old_amount }}</s></span><span class="vper">{{ section.settings.old_per }}</span></div>
        <div class="vrow new"><span class="vlbl">{{ section.settings.new_label }}</span><span class="vamt">{% render 'bella-copy', text: section.settings.new_amount %}</span><span class="vper">{{ section.settings.new_per }}</span></div>
      </div>
    {%- endif -%}
    <p class="value-note">{% render 'bella-copy', text: section.settings.note %}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn-wht" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- assign links = section.blocks | where: 'type', 'link' -%}
    {%- if links.size > 0 -%}
      <div class="value-also">
        <span class="va-lead">{{ section.settings.also_label }}</span>
        {%- for block in links -%}
          <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- unless forloop.last %}<span class="va-dot" aria-hidden="true">·</span>{% endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cost comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The math" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same result. A fraction of the cost." },
    { "type": "text", "id": "old_label", "label": "Row 1 label", "default": "Physical staging" },
    { "type": "text", "id": "old_amount", "label": "Row 1 amount (struck through)", "default": "$2,000–5,000" },
    { "type": "text", "id": "old_per", "label": "Row 1 detail", "default": "a month · until it sells · the furniture goes back" },
    { "type": "text", "id": "new_label", "label": "Row 2 label", "default": "Bella virtual staging" },
    { "type": "text", "id": "new_amount", "label": "Row 2 amount", "default": "{price:virtual-staging-1}" },
    { "type": "text", "id": "new_per", "label": "Row 2 detail", "default": "a photo · paid once · yours for the whole listing" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Staging does one job: it shows buyers the full potential of a home. Real furniture or virtual, a staged room sets the scene, fills the space, and lets a buyer imagine themselves living there. Both earn the same reaction in the first three photos, where the click is won or lost. The only real difference is the bill: physical staging runs thousands a month and leaves the day the home sells, while Bella does the same job once, for about a tenth of the cost." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the full comparison →" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "also_label", "label": "Other-services lead-in", "default": "Virtual staging is our flagship — the same designers also deliver:" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Other service link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "3D Renderings" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "pair",
      "name": "Savings row",
      "settings": [
        { "type": "text", "id": "service", "label": "What you're doing", "default": "Staging a vacant listing" },
        { "type": "text", "id": "old_label", "label": "The old way", "default": "Physical staging" },
        { "type": "text", "id": "old_amount", "label": "Old cost (struck through)", "default": "$2,000–5,000 a month" },
        { "type": "text", "id": "new_amount", "label": "Bella price", "default": "{price:virtual-staging-1}" },
        { "type": "text", "id": "new_unit", "label": "Bella unit", "default": "a photo · paid once" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the service →" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Cost comparison" }]
}
{% endschema %}
