{% style %}
.case-rows{display:flex;flex-direction:column;gap:26px;margin-top:34px}
.case-row{border:1px solid var(--line);border-radius:14px;padding:26px;background:#fff;display:grid;grid-template-columns:.85fr 1.15fr;gap:32px;align-items:center}
.case-media{position:relative;border-radius:12px;overflow:hidden;background:#EFECE8;aspect-ratio:4/3}
.case-media img,.case-media svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.case-media .case-ph-tag{position:absolute;left:12px;bottom:12px;z-index:2;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(20,18,16,.55);padding:4px 10px;border-radius:99px}
.case-main .micro{color:var(--green)}
.case-main h2{font-size:clamp(21px,2.3vw,27px);font-weight:400;margin-top:8px;letter-spacing:-.01em}
.case-main>p{color:var(--soft);font-size:14.5px;line-height:1.75;margin-top:12px;max-width:60ch}
.case-side{display:flex;flex-wrap:wrap;gap:12px 30px;margin-top:18px}
.case-stat{border-left:2px solid var(--green);padding:2px 0 2px 13px}
.case-stat b{display:block;font-size:21px;font-weight:400;color:var(--ink);letter-spacing:-.01em}
.case-stat span{font-size:12px;color:#6c6f6b;line-height:1.5}
.case-quote{width:100%;margin-top:8px;border-top:1px solid var(--line-2);padding-top:13px;font-size:14px;color:var(--ink);font-style:italic;line-height:1.6}
.case-quote cite{display:block;margin-top:6px;font-style:normal;font-size:12px;color:#6c6f6b}
.case-note{margin-top:24px;font-size:12.5px;color:#6c6f6b;line-height:1.6;max-width:78ch}
@media(max-width:820px){.case-row{grid-template-columns:1fr;padding:20px;gap:18px}}
{% endstyle %}
<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        {%- if section.settings.sub -%}<h2 style="font-size:clamp(25px,2.9vw,38px);font-weight:300">{{ section.settings.heading }}</h2>{%- else -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="case-rows">
        {%- for block in section.blocks -%}
          <article class="case-row" {{ block.shopify_attributes }}>
            <div class="case-media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1000, height: 750, crop: 'center' }}" alt="{{ block.settings.name | escape }} — project by Bella" loading="lazy" width="1000" height="750">
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name | escape }} — project by Bella" loading="lazy" width="1000" height="750">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
                <span class="case-ph-tag">Project photo coming soon</span>
              {%- endif -%}
            </div>
            <div class="case-main">
              <p class="micro">{{ block.settings.sub }}</p>
              <h2>{{ block.settings.name }}</h2>
              <p>{{ block.settings.text }}</p>
              <div class="case-side">
                {%- for i in (1..3) -%}
                  {%- assign key = 'stat' | append: i -%}
                  {%- assign raw = block.settings[key] -%}
                  {%- if raw != blank -%}
                    {%- assign parts = raw | split: '|' -%}
                    <div class="case-stat"><b>{{ parts[0] | strip }}</b><span>{{ parts[1] | strip }}</span></div>
                  {%- endif -%}
                {%- endfor -%}
                {%- if block.settings.quote != blank -%}
                  <div class="case-quote">&ldquo;{{ block.settings.quote }}&rdquo;<cite>{{ block.settings.quote_by }}</cite></div>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="case-note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Case study rows",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Case studies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How teams use Bella." },
    { "type": "checkbox", "id": "sub", "label": "Render heading as H2 (page already has an H1)", "default": true },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "textarea", "id": "note", "label": "Note under the rows" }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Case study",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Project image" },
        { "type": "text", "id": "image_url", "label": "Project image URL (used when no image is picked)" },
        { "type": "text", "id": "sub", "label": "Client type / market", "default": "Luxury brokerage · New York" },
        { "type": "text", "id": "name", "label": "Client name", "default": "Client" },
        { "type": "textarea", "id": "text", "label": "Story" },
        { "type": "text", "id": "stat1", "label": "Stat 1 (Figure|Label)" },
        { "type": "text", "id": "stat2", "label": "Stat 2 (Figure|Label)" },
        { "type": "text", "id": "stat3", "label": "Stat 3 (Figure|Label)" },
        { "type": "text", "id": "quote", "label": "Quote (optional)" },
        { "type": "text", "id": "quote_by", "label": "Quote attribution" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Case study rows" }]
}
{% endschema %}
