<header>
  <div class="nav">
    <a class="mark" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name | escape }}" style="height:26px;width:auto;display:block" width="240" height="80">
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>
    <nav>
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    {%- comment -%}
      Market switcher. Driven by localization.available_countries so it stays
      right when a market is added in admin, rather than a list hard-coded here.
      Submitting the form is what actually switches currency and checkout; the
      dropdown is progressive enhancement on top of a plain submit button, so it
      still works with no JS.
    {%- endcomment -%}
    {%- if section.settings.show_market and localization.available_countries.size > 1 -%}
      {%- form 'localization', id: 'MarketForm', class: 'mkt' -%}
        <input type="hidden" name="return_to" value="{{ request.path | escape }}">
        <button type="button" class="mkt-btn" id="MarketBtn" aria-expanded="false" aria-controls="MarketList" aria-label="Change region. Current region {{ localization.country.name | escape }}, {{ localization.country.currency.iso_code }}">
          {%- render 'bella-flag', code: localization.country.iso_code, size: 18 -%}
          <span class="mkt-cur">{{ localization.country.currency.iso_code }}</span>
          <svg class="mkt-caret" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        {%- comment -%}
          available_countries is every country Shopify ships to (234 here), but
          they resolve to only four currencies: 231 of them are USD. Listing all
          234 would be a wall of identical choices, so we show one country per
          currency, named in the setting below.
        {%- endcomment -%}
        {%- assign wanted = section.settings.market_codes | default: 'US,CA,GB,AU' | upcase | replace: ' ', '' -%}
        {%- assign wanted_lookup = ',' | append: wanted | append: ',' -%}
        <ul class="mkt-list" id="MarketList" hidden>
          {%- for c in localization.available_countries -%}
            {%- assign probe = ',' | append: c.iso_code | append: ',' -%}
            {%- unless wanted_lookup contains probe -%}{%- continue -%}{%- endunless -%}
            <li>
              <button type="submit" name="country_code" value="{{ c.iso_code }}" class="mkt-opt{% if c.iso_code == localization.country.iso_code %} on{% endif %}"{% if c.iso_code == localization.country.iso_code %} aria-current="true"{% endif %}>
                {%- render 'bella-flag', code: c.iso_code, size: 18 -%}
                <span class="mkt-name">{{ c.name }}</span>
                <span class="mkt-cur">{{ c.currency.iso_code }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endform -%}
    {%- endif -%}
    {%- comment -%}
      Tap to call. The href is stripped to digits because a tel: link must not
      carry spaces or brackets, while the label keeps the punctuation a person
      reads. On a phone the number itself is hidden and the handset stays, so
      calling is one tap without crowding a 360px bar.
    {%- endcomment -%}
    {%- if section.settings.phone != blank -%}
      {%- assign tel_digits = section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
      <a class="nav-tel" href="tel:{{ tel_digits }}" aria-label="Call {{ section.settings.phone | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{{ section.settings.phone }}</span>
      </a>
    {%- endif -%}
    <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
    <button class="nav-burger" id="NavBurger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="MobileNav">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="MobileNav" aria-label="Mobile menu">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
    {%- if section.settings.phone != blank -%}
      {%- assign tel_digits = section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
      <a class="mobile-tel" href="tel:{{ tel_digits }}">{{ section.settings.phone }}</a>
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "BELLA", "info": "Used when no logo image is set" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get started" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+1 (888) 471-2278", "info": "Shown in the header as a tap-to-call link. Confirm this is the number you want customers ringing. Empty hides it." },
    { "type": "checkbox", "id": "show_market", "label": "Show region / currency switcher", "info": "Hidden automatically unless the shop has more than one market.", "default": true },
    { "type": "text", "id": "market_codes", "label": "Regions to offer", "info": "Comma-separated ISO country codes, one per currency you sell in. Empty falls back to US,CA,GB,AU.", "default": "US,CA,GB,AU" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ]
}
{% endschema %}
