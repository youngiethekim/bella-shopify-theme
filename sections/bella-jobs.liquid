          "before_url": "https://www.bellavirtual.com/cdn/shop/files/Gareth_Roberts_-_Living_room_to_Dinning_Room_S210-120_Bayview_Ave-13.jpg?width=1200",
          "customer": "Real estate agent · Toronto", "name": "120 Bayview Ave",
