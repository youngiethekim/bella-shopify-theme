<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="steps">
        {%- for block in section.blocks -%}
          <div class="step" {{ block.shopify_attributes }}>
            <div class="n">Step {{ forloop.index }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From empty to irresistible in three steps." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Upload your photos" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Send the empty-room shots and tell us the style you want, or let our designers choose what sells for your buyer." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Order & upload", "text": "Place your order, then send your photos — right after checkout or whenever you're ready. No upload needed to get started." } },
        { "type": "step", "settings": { "title": "A designer stages it", "text": "A real interior designer furnishes each room to feel lived-in and aspirational, matched to your local market." } },
        { "type": "step", "settings": { "title": "Approve & download", "text": "Mark up anything you'd like changed, then download MLS-ready files. Unlimited revisions, free for two weeks." } }
      ]
    }
  ]
}
{% endschema %}
