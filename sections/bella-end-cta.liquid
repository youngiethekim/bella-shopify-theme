<section class="end">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="2000" height="1250">
  {%- else -%}
    <img src="https://www.bellavirtual.com/cdn/shop/files/2_c53d1862-2e10-4866-b881-92c3b7d5da1e.png?width=2000" alt="A Manhattan high-rise bedroom after virtual staging by a Bella interior designer" width="2000" height="1250">
  {%- endif -%}
  <div class="scrim"></div>
  <div class="in">
    <span class="micro" style="color:rgba(255,255,255,.6)">{{ section.settings.eyebrow }}</span>
    <h2 style="margin-top:14px">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="row">
      {%- liquid
        assign cta_href = section.settings.cta_link
        if cta_href == blank
          if template.name == 'product'
            assign cta_href = '#BuyBox'
          else
            assign cta_href = routes.all_products_collection_url
          endif
        endif
      -%}
      <a class="btn btn-wht" href="{{ cta_href }}">{{ section.settings.cta_label }}</a>
    </div>
    {%- if section.settings.fine_print != blank -%}
      <small>{{ section.settings.fine_print }}</small>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your next listing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stand out from the competition." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "While other listings show empty rooms, yours shows a home — designer-composed, MLS-ready images back in 24 to 48 hours." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get started — $45 a photo" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unlimited revisions for two weeks · Don't love it? We rework it or refund it." }
  ],
  "presets": [{ "name": "Closing CTA" }]
}
{% endschema %}
