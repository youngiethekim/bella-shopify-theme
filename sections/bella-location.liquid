{%- comment -%}
  One section drives all 15 location pages, so every price here is read from the
  product that charges it. Copy settings may use {price:handle} tokens; see the
  bella-copy snippet.
{%- endcomment -%}
{%- liquid
  assign svc_staging = settings.product_staging | default: all_products['virtual-staging']
  assign svc_renovation = settings.product_renovation | default: all_products['virtual-renovation-service']
  assign svc_rendering = settings.product_rendering | default: all_products['3d-rendering-service-for-architectural-visualization']
  assign svc_floorplan = settings.product_floorplan | default: all_products['2d-3d-floor-plan-service']
  assign svc_editing = settings.product_editing | default: all_products['real-estate-photo-editing']

  assign loc_cta_label = section.settings.cta_label | default: 'Stage my listing — from {price:virtual-staging}'
  assign loc_cta_link = section.settings.cta_link
  if loc_cta_link == blank
    assign loc_cta_link = svc_staging.url | default: routes.all_products_collection_url
  endif
-%}
<section class="loc-hero">
  <span class="micro">{{ section.settings.eyebrow }}</span>
  <h1>{{ section.settings.heading }}</h1>
  <p class="loc-lede">{% render 'bella-copy', text: section.settings.lede %}</p>
  <div class="row">
    <a class="btn" href="{{ loc_cta_link }}">{% render 'bella-copy', text: loc_cta_label %}</a>
    <a class="loc-alt" href="{{ section.settings.alt_link | default: '/pages/lookbook' }}">{{ section.settings.alt_label | default: 'Browse the lookbook' }}</a>
  </div>
  <div class="loc-cred">
    <span>{% render 'bella-price', product: svc_staging, prefix: 'From', suffix: 'a photo', fallback: 'Real designer staging' %}</span><span>·</span><span>24–48 hour delivery</span><span>·</span><span>Real designers, never AI</span><span>·</span><span>Rework or refund</span>
  </div>
</section>
<section class="loc-body">
  <div class="loc-grid">
    <div>
      <h2>{{ section.settings.market_heading }}</h2>
      {% render 'bella-copy', text: section.settings.market_text %}
    </div>
    <div>
      <h2>{{ section.settings.local_heading }}</h2>
      {% render 'bella-copy', text: section.settings.local_text %}
      {%- if section.settings.hoods != blank -%}
        <div class="loc-hoods">
          <span class="micro">{{ section.settings.hoods_label | default: 'Where we stage most' }}</span>
          <div class="loc-chips">
            {%- assign hoods = section.settings.hoods | split: ',' -%}
            {%- for h in hoods -%}<span class="chip">{{ h | strip }}</span>{%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.city != blank -%}
  <div class="loc-services">
    <span class="micro">Every Bella service, available in {{ section.settings.city }}</span>
    <div class="loc-svc-row">
      {%- comment -%} Link and price both come from the product, so a discontinued service drops out instead of dead-linking. {%- endcomment -%}
      {%- if svc_staging != blank -%}
        <a href="{{ svc_staging.url }}">Virtual staging <b>{% render 'bella-price', product: svc_staging, prefix: 'from' %}</b></a>
      {%- endif -%}
      {%- if svc_renovation != blank -%}
        <a href="{{ svc_renovation.url }}">Virtual renovation <b>{% render 'bella-price', product: svc_renovation, prefix: 'from' %}</b></a>
      {%- endif -%}
      {%- if svc_rendering != blank -%}
        <a href="{{ svc_rendering.url }}">3D rendering <b>{% render 'bella-price', product: svc_rendering, prefix: 'from' %}</b></a>
      {%- endif -%}
      {%- if svc_floorplan != blank -%}
        <a href="{{ svc_floorplan.url }}">Floor plans</a>
      {%- endif -%}
      {%- if svc_editing != blank -%}
        <a href="{{ svc_editing.url }}">Photo editing</a>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>

{%- comment -%}
  Local SEO is the entire point of these pages, so describe what Bella actually
  is: a Service with the area it serves. Deliberately not LocalBusiness — Bella
  has no premises in these cities, and an invented address per city would be
  fabricated data that Google treats as spam.
{%- endcomment -%}
{%- if section.settings.city != blank -%}
  {%- capture loc_description -%}{% render 'bella-copy', text: section.settings.lede %}{%- endcapture -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": {{ section.settings.heading | default: page.title | json }},
    "serviceType": {{ section.settings.service_type | default: 'Virtual staging' | json }},
    "description": {{ loc_description | strip_html | strip | json }},
    "url": {{ canonical_url | json }},
    "provider": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.secure_url | json }}
    },
    "areaServed": {
      "@type": {{ section.settings.area_type | default: 'City' | json }},
      "name": {{ section.settings.city | json }}
    }{% if svc_staging.price_min > 0 %},
    "offers": {
      "@type": "Offer",
      "price": {{ svc_staging.price_min | divided_by: 100.0 }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/InStock",
      "url": {{ shop.secure_url | append: svc_staging.url | json }}
    }{% endif %}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.secure_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ section.settings.city | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Location page",
  "settings": [
    { "type": "paragraph", "content": "Write prices as {price:virtual-staging} — the live price of that product is filled in, in the visitor's currency. Handles: virtual-staging, virtual-renovation-service, 3d-rendering-service-for-architectural-visualization, 360-virtual-tour-staging, 2d-3d-floor-plan-service, real-estate-photo-editing." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Virtual staging near you" },
    { "type": "text", "id": "heading", "label": "Heading (H1)" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "info": "Default: Stage my listing — from {price:virtual-staging}" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "info": "Defaults to the virtual staging product." },
    { "type": "text", "id": "alt_label", "label": "Secondary link label" },
    { "type": "url", "id": "alt_link", "label": "Secondary link" },
    { "type": "text", "id": "city", "label": "City name (for services row)", "info": "Also the area served in this page's search-engine markup. Leave empty to omit both." },
    { "type": "select", "id": "area_type", "label": "This area is a", "default": "City", "options": [
      { "value": "City", "label": "City" },
      { "value": "AdministrativeArea", "label": "State / province / region" },
      { "value": "Country", "label": "Country" } ] },
    { "type": "text", "id": "service_type", "label": "Service described", "default": "Virtual staging", "info": "Used in this page's search-engine markup." },
    { "type": "text", "id": "market_heading", "label": "Market column heading" },
    { "type": "richtext", "id": "market_text", "label": "Market column text" },
    { "type": "text", "id": "local_heading", "label": "Local column heading" },
    { "type": "richtext", "id": "local_text", "label": "Local column text" },
    { "type": "text", "id": "hoods_label", "label": "Neighbourhoods label" },
    { "type": "text", "id": "hoods", "label": "Neighbourhoods (comma-separated)" }
  ],
  "presets": [{ "name": "Location page" }]
}
{% endschema %}
