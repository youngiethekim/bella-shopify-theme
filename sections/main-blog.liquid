<div class="shop-wrap">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="blog-list">
      {%- for article in blog.articles -%}
        <a class="coll-card" href="{{ article.url }}">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="600" height="450">
          {%- endif -%}
          <div class="cc-body">
            <div class="cc-title">{{ article.title }}</div>
            <div class="cc-price">{{ article.published_at | date: '%B %-d, %Y' }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
