{%- liquid
  assign rooms = section.blocks | where: 'type', 'room'
  assign services = section.blocks | where: 'type', 'service'
-%}
<section class="what" id="services">
  <div class="head">
    <p class="micro">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="wrap">
    {%- if rooms.size > 0 -%}
    <div class="pbrowse" id="pbrowse">
      <div class="pb-stage">
        <button class="pb-arw" id="pbPrev" type="button" aria-label="Previous room">&#8249;</button>
        <div class="pb-slider" id="pbSlider">
          <img class="pb-after" id="pbAfter" src="" alt="A room staged by {{ shop.name | escape }}" width="1200" height="800">
          <img class="pb-before" id="pbBefore" src="" alt="The same room empty, before staging" width="1200" height="800">
          <span class="pb-lbl pb-lbl-b">Before</span>
          <span class="pb-lbl pb-lbl-a">After</span>
          <div class="pb-handle" id="pbHandle"><span class="pb-grip"></span></div>
        </div>
        <button class="pb-arw" id="pbNext" type="button" aria-label="Next room">&#8250;</button>
      </div>
      <div class="pb-bar">
        <div class="pb-meta"><b id="pbRoom"></b><span id="pbProj">{{ section.settings.project_label }}</span></div>
        <span class="pb-count"><b id="pbNum">01</b> / <span id="pbTot">{{ rooms.size | prepend: '0' | slice: -2, 2 }}</span> · drag to reveal</span>
      </div>
      <div class="pb-thumbs" id="pbThumbs">
        {%- for block in rooms -%}
          {%- liquid
            assign before_fallback = 'proj-' | append: block.settings.sample | append: '-before.jpg' | asset_url
            assign after_fallback = 'proj-' | append: block.settings.sample | append: '-after.jpg' | asset_url
            if block.settings.before != blank
              assign before_src = block.settings.before | image_url: width: 1600
            else
              assign before_src = before_fallback
            endif
            if block.settings.after != blank
              assign after_src = block.settings.after | image_url: width: 1600
            else
              assign after_src = after_fallback
            endif
          -%}
          <button type="button" aria-label="{{ block.settings.room | escape }}"
            data-room="{{ block.settings.room | escape }}"
            data-before="{{ before_src }}"
            data-after="{{ after_src }}" {{ block.shopify_attributes }}>
            <img src="{{ after_src }}" alt="{{ block.settings.room | escape }}, staged" loading="lazy" width="1200" height="800">
          </button>
        {%- endfor -%}
      </div>
      {%- if section.settings.project_desc != blank -%}
        <p class="pb-desc">{{ section.settings.project_desc }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="svc-intro">
      <p class="micro">{{ section.settings.intro_eyebrow }}</p>
      <h3>{{ section.settings.intro_heading }}</h3>
      <p>{{ section.settings.intro_text }}</p>
    </div>
    <div class="svc-hero">
      {%- if section.settings.feature_image != blank -%}
        <img src="{{ section.settings.feature_image | image_url: width: 2000 }}" alt="{{ section.settings.feature_image.alt | default: shop.name | escape }}" loading="lazy" width="2000" height="1250">
      {%- else -%}
        <img src="{{ 'dusk-home.jpg' | asset_url }}" alt="A modern luxury home at dusk, warm windows glowing over a reflecting pool" loading="lazy" width="1200" height="800">
      {%- endif -%}
    </div>
    <div class="svc-grid">
      {%- for block in services -%}
        <div class="svc-item" {{ block.shopify_attributes }}>
          <svg class="ico"><use href="#i-{{ block.settings.icon }}"/></svg>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Staged for how buyers in your market feel." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're interior designers and real estate professionals who have staged thousands of listings. Using local buyer data, we design every room to trigger the feeling that sells, then deliver the full visual package in 24 to 48 hours." },
    { "type": "text", "id": "project_label", "label": "Project label", "default": "Concord Pacific · Concord Gardens · Richmond, BC" },
    { "type": "textarea", "id": "project_desc", "label": "Project description", "default": "Concord Gardens is a master-planned community by Concord Pacific in Richmond, BC. Bella staged a full home here: the kitchen, living and dining, and every bedroom. We furnished the empty rooms so buyers could feel the lifestyle before a single piece of furniture arrived." },
    { "type": "header", "content": "Services intro" },
    { "type": "text", "id": "intro_eyebrow", "label": "Eyebrow", "default": "Our team" },
    { "type": "text", "id": "intro_heading", "label": "Heading", "default": "Real estate visualization & marketing specialists in your corner." },
    { "type": "textarea", "id": "intro_text", "label": "Text", "default": "One studio designs and delivers everything below — the full visual package that makes your residential and commercial properties stand out from the competition and stops buyers mid-scroll." },
    { "type": "image_picker", "id": "feature_image", "label": "Feature image", "info": "Leave empty for the bundled dusk exterior" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Before/after room",
      "settings": [
        { "type": "text", "id": "room", "label": "Room name", "default": "Living room" },
        { "type": "image_picker", "id": "before", "label": "Before photo" },
        { "type": "image_picker", "id": "after", "label": "After photo" },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample photos (used until you pick your own)",
          "default": "living",
          "options": [
            { "value": "living", "label": "Living room" },
            { "value": "kitchen", "label": "Kitchen" },
            { "value": "dining", "label": "Dining" },
            { "value": "primary", "label": "Primary bedroom" },
            { "value": "bed2", "label": "Bedroom 2" },
            { "value": "bed3", "label": "Bedroom 3" }
          ]
        }
      ]
    },
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sofa",
          "options": [
            { "value": "sofa", "label": "Sofa" },
            { "value": "eraser", "label": "Eraser" },
            { "value": "roller", "label": "Paint roller" },
            { "value": "plan", "label": "Floor plan" },
            { "value": "sun", "label": "Sun / dusk" },
            { "value": "360", "label": "360°" },
            { "value": "cube", "label": "3D cube" },
            { "value": "cloud", "label": "Cloud / sky" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Virtual staging" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Empty rooms furnished by real interior designers to match the home and the buyer." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services showcase",
      "blocks": [
        { "type": "room", "settings": { "room": "Living room", "sample": "living" } },
        { "type": "room", "settings": { "room": "Kitchen & island", "sample": "kitchen" } },
        { "type": "room", "settings": { "room": "Kitchen & dining", "sample": "dining" } },
        { "type": "room", "settings": { "room": "Primary bedroom", "sample": "primary" } },
        { "type": "room", "settings": { "room": "Second bedroom", "sample": "bed2" } },
        { "type": "room", "settings": { "room": "Bedroom", "sample": "bed3" } },
        { "type": "service", "settings": { "icon": "sofa", "title": "Virtual staging", "text": "Empty rooms furnished by real interior designers to match the home and the buyer." } },
        { "type": "service", "settings": { "icon": "eraser", "title": "Furniture removal", "text": "Clear occupied or cluttered rooms, then restage them clean." } },
        { "type": "service", "settings": { "icon": "roller", "title": "Virtual renovation", "text": "Modernize dated finishes, floors, and fixtures before staging." } },
        { "type": "service", "settings": { "icon": "plan", "title": "3D floor plans", "text": "Furnished, to-scale layouts buyers can actually walk." } },
        { "type": "service", "settings": { "icon": "sun", "title": "Day-to-dusk edits", "text": "Turn a flat daytime exterior into a warm twilight hero shot." } },
        { "type": "service", "settings": { "icon": "360", "title": "Virtual tours & 360°", "text": "Walkable 360° tours with every room virtually staged. We furnish the empty spaces, then stitch them into one immersive walkthrough." } },
        { "type": "service", "settings": { "icon": "cube", "title": "3D renders", "text": "Photoreal interiors and exteriors from plans, before you build." } },
        { "type": "service", "settings": { "icon": "cloud", "title": "Sky swaps & photo edits", "text": "Sky replacement, item removal, and general image enhancement." } }
      ]
    }
  ]
}
{% endschema %}
