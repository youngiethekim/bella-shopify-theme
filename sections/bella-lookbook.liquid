{%- comment -%}
  Lookbook 2026. Everything is scoped under .blb.

  ⚠ All 300 set photos are still served from youngiethekim.github.io/bella-preview
  (see DATA in bella-lookbook.js) — roughly 45 MB on a personal GitHub Pages site
  with no uptime guarantee, no CDN resizing, and nothing stopping that repo from
  being renamed. Re-host them in Shopify Files and rewrite the img values before
  this theme goes live; that is admin work, not theme work.

  Was an HTML comment, so this shipped to every visitor.
{%- endcomment -%}
{{ 'bella-lookbook.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    The favourites bar hands saved looks off to an order, so the destination is
    a setting rather than a path typed into the script.
  endcomment
  assign lookbook_product = settings.product_staging | default: all_products['virtual-staging-1']
  assign lookbook_order_url = settings.lookbook_order_url | default: lookbook_product.url | default: routes.all_products_collection_url
-%}
<div class="blb" data-order-url="{{ lookbook_order_url }}">
  <div class="blb-hero">
    <p class="blb-eye">Lookbook 2026 · Designer-staged rooms</p>
    <h2 class="blb-h">Browse the collection.</h2>
    <p class="blb-sub">Want a certain look for your project? Select the furniture set you'd like us to use for your virtual staging or 3D rendering — every set is a real room styled by our designers. Filter by room, style or brand, then copy the look's code and send it with your order.</p>
  </div>

  <div class="blb-bar">
    <div class="blb-row">
      <label class="blb-search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9C978F" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input type="text" class="blb-q" placeholder="Search a code, room or style"></label>
      <select class="blb-sel blb-style"><option value="">All styles</option><option value="Modern">Modern</option><option value="Contemporary">Contemporary</option><option value="Coastal">Coastal</option><option value="Mid-Century">Mid-Century</option><option value="Scandinavian">Scandinavian</option><option value="Transitional">Transitional</option><option value="Farmhouse">Farmhouse</option><option value="Modern Farmhouse">Modern Farmhouse</option><option value="Nordic Boho">Nordic Boho</option><option value="Bold Luxe">Bold Luxe</option><option value="Traditional">Traditional</option><option value="Patio">Patio</option><option value="Sky">Sky</option></select>
      <select class="blb-sel blb-brand"><option value="">All brands</option><option value="Rove Concepts">Rove Concepts</option><option value="Sundays">Sundays</option><option value="Mobital">Mobital</option><option value="Gus*">Gus*</option><option value="Eternity Modern">Eternity Modern</option><option value="Roche Bobois">Roche Bobois</option></select>
    </div>
    <div class="blb-chips">
      <button class="blb-chip blb-room on" data-room="">All</button><button class="blb-chip blb-room" data-room="Living Room">Living Room</button><button class="blb-chip blb-room" data-room="Dining Room">Dining Room</button><button class="blb-chip blb-room" data-room="Bedroom">Bedroom</button><button class="blb-chip blb-room" data-room="Kitchen">Kitchen</button><button class="blb-chip blb-room" data-room="Office">Office</button><button class="blb-chip blb-room" data-room="Exterior">Exterior</button>
      <span class="blb-count"></span>
      <button class="blb-clear" type="button">Clear</button>
    </div>
  </div>

  <div class="blb-grid"></div>
  <div class="blb-empty" style="display:none">No sets match those filters. Try clearing a filter.</div>
</div>

<div class="blb-lb" aria-hidden="true">
  <button class="x" aria-label="Close">&times;</button>
  <button class="arw prev" aria-label="Previous">&#8249;</button>
  <button class="arw next" aria-label="Next">&#8250;</button>
  <figure>
    <img alt="" width="1200" height="900">
    <div class="cap"><div><b class="lb-label"></b><small class="lb-meta"></small></div>
      <div style="display:flex;gap:10px"><button class="lb-copy pri">Copy code</button></div></div>
  </figure>
</div>
<div class="blb-toast"></div>

<script src="{{ 'bella-lookbook.js' | asset_url }}" defer></script>

{%- comment -%}
  The favourites bar and lightbox live in bella-pdp.js, which the layout only
  loads on product pages. Pull it in here so this section keeps working wherever
  it is placed, without loading it twice on a product page.
{%- endcomment -%}
{%- unless template.name == 'product' -%}
  <script src="{{ 'bella-pdp.js' | asset_url }}" defer></script>
{%- endunless -%}

{% schema %}
{
  "name": "Lookbook",
  "settings": [],
  "presets": [{ "name": "Lookbook" }]
}
{% endschema %}
