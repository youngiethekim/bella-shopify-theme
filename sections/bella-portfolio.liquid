<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        {%- if section.settings.sub -%}<h2 style="font-size:clamp(25px,2.9vw,38px);font-weight:300">{{ section.settings.heading }}</h2>{%- else -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="pf-grid{% if section.settings.carousel %} pf-carousel{% endif %}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign before_fallback = 'proj-' | append: block.settings.sample | append: '-before.jpg' | asset_url
            assign after_fallback = 'proj-' | append: block.settings.sample | append: '-after.jpg' | asset_url
            if block.settings.before_url != blank
              assign before_src = block.settings.before_url
            else
              assign before_src = before_fallback
            endif
            if block.settings.after_url != blank
              assign after_src = block.settings.after_url
            else
              assign after_src = after_fallback
            endif
          -%}
          <figure class="pf-card" tabindex="0" {{ block.shopify_attributes }}>
            <div class="pf-shot">
              <img class="pf-after" src="{{ after_src }}" alt="{{ block.settings.name | escape }}, after — {{ block.settings.services | escape }}" loading="lazy" width="1200" height="800">
              <img class="pf-before" src="{{ before_src }}" alt="{{ block.settings.name | escape }}, before" loading="lazy" width="1200" height="800">
              <span class="pf-tag">{{ block.settings.tag | default: 'Before ⇄ After' }}</span>
            </div>
            <figcaption>
              <b>{{ block.settings.name }}</b>
              <span class="pf-cust">{{ block.settings.customer }}</span>
              <span class="pf-meta">{{ block.settings.services }}{% if block.settings.outcome != blank %} · <em>{{ block.settings.outcome }}</em>{% endif %}</span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      {%- if section.settings.look_label != blank or section.settings.cta_label != blank -%}
        <div class="pf-foot">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn" href="{{ section.settings.cta_url | default: '/products/virtual-staging' }}">{% render 'bella-price-text', text: section.settings.cta_label %}</a>
          {%- endif -%}
          {%- if section.settings.look_label != blank -%}
            <a class="pf-look" href="{{ section.settings.look_url | default: '/pages/lookbook' }}">{{ section.settings.look_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Portfolio",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Portfolio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our best work." },
    { "type": "checkbox", "id": "sub", "label": "Render heading as H2 (page already has an H1)", "default": false },
    { "type": "checkbox", "id": "carousel", "label": "Show projects as a swipeable carousel", "default": false },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Real listings, staged, rendered and edited by the Bella team — and what happened after. Hover or tap any project to see the room we started with." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get started — from {price:virtual-staging} a photo" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "look_label", "label": "Lookbook link label", "default": "Browse 300+ furnished looks in the lookbook →" },
    { "type": "url", "id": "look_url", "label": "Lookbook link" }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "text", "id": "name", "label": "Project name", "default": "Living room" },
        { "type": "text", "id": "customer", "label": "Customer / market", "default": "Real estate agent" },
        { "type": "text", "id": "services", "label": "Services used", "default": "Virtual staging" },
        { "type": "text", "id": "outcome", "label": "Outcome", "default": "Sold" },
        { "type": "text", "id": "tag", "label": "Corner tag", "default": "Before ⇄ After" },
        { "type": "text", "id": "before_url", "label": "Before image URL" },
        { "type": "text", "id": "after_url", "label": "After image URL" },
        {
          "type": "select",
          "id": "sample",
          "label": "Sample photos (used when URLs are empty)",
          "default": "living",
          "options": [
            { "value": "living", "label": "Living room" },
            { "value": "kitchen", "label": "Kitchen" },
            { "value": "dining", "label": "Dining" },
            { "value": "primary", "label": "Primary bedroom" },
            { "value": "bed2", "label": "Bedroom 2" },
            { "value": "bed3", "label": "Bedroom 3" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Portfolio" }]
}
{% endschema %}
