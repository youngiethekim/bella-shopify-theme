{% style %}
.cred-marks{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:34px}
.cred-mark{border:1px solid var(--line);border-radius:12px;padding:20px 16px;text-align:center;background:#fff}
.cred-mark b{display:block;font-size:15px;font-weight:600;letter-spacing:.01em}
.cred-mark span{display:block;margin-top:5px;font-size:12px;color:#6c6f6b}
.cred-note{margin-top:24px;text-align:center;font-size:13px;color:#6c6f6b;max-width:640px;margin-left:auto;margin-right:auto}
@media(max-width:600px){.cred-marks{grid-template-columns:1fr 1fr;gap:10px}.cred-mark{padding:15px 10px}.cred-mark b{font-size:13.5px}}
{% endstyle %}
<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        {%- if section.settings.sub -%}<h2 style="font-size:clamp(25px,2.9vw,38px);font-weight:300">{{ section.settings.heading }}</h2>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cred-marks">
          {%- for block in section.blocks -%}
            <div class="cred-mark" {{ block.shopify_attributes }}>
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="cred-note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Credibility band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "World-class artists. Top-tier projects." },
    { "type": "checkbox", "id": "sub", "label": "Lighter heading style", "default": true },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "text", "id": "note", "label": "Note under the marks" }
  ],
  "blocks": [
    {
      "type": "mark",
      "name": "Project / client",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Project name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Property developer" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Credibility band" }]
}
{% endschema %}
