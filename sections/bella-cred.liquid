<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        {%- if section.settings.sub -%}<h2 style="font-size:clamp(25px,2.9vw,38px);font-weight:300">{{ section.settings.heading }}</h2>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cred-marks">
          {%- for block in section.blocks -%}
            <div class="cred-mark" {{ block.shopify_attributes }}>
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail }}</span>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="cred-note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Credibility band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "World-class artists. Top-tier projects." },
    { "type": "checkbox", "id": "sub", "label": "Lighter heading style", "default": true },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "text", "id": "note", "label": "Note under the marks" }
  ],
  "blocks": [
    {
      "type": "mark",
      "name": "Project / client",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Project name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Property developer" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Credibility band" }]
}
{% endschema %}
