<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        <p class="micro">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="reqs-grid">
        <div>
          <h3 class="reqs-h">{{ section.settings.req_heading | default: 'What we need from you' }}</h3>
          <ul class="reqs-list req">
            {%- for block in section.blocks -%}
              {%- if block.type == 'req' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <div>
          <h3 class="reqs-h">{{ section.settings.get_heading | default: 'What you get back' }}</h3>
          <ul class="reqs-list ok">
            {%- for block in section.blocks -%}
              {%- if block.type == 'get' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
      {%- if section.settings.note != blank -%}
        <p class="reqs-note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Needs & deliverables",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Black and white" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we need. What you get." },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "req_heading", "label": "Requirements column heading", "default": "What we need from you" },
    { "type": "text", "id": "get_heading", "label": "Deliverables column heading", "default": "What you get back" },
    { "type": "textarea", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "req",
      "name": "Requirement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Requirement" }
      ]
    },
    {
      "type": "get",
      "name": "Deliverable",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Deliverable" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Needs & deliverables" }]
}
{% endschema %}
