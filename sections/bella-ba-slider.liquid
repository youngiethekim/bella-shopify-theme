<div class="svc-page">
  <section class="sec">
    <div class="sec-in">
      <div class="head2">
        {%- if section.settings.eyebrow != blank -%}<p class="micro">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-size:clamp(25px,2.9vw,38px);font-weight:300">{% render 'bella-price-text', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<p>{% render 'bella-price-text', text: section.settings.text %}</p>{%- endif -%}
      </div>

      <div class="ba-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign before_src = block.settings.before_image | image_url: width: 1600
            assign after_src = block.settings.after_image | image_url: width: 1600
            if block.settings.before_image == blank and block.settings.before_asset != blank
              assign before_src = block.settings.before_asset | asset_url
            endif
            if block.settings.after_image == blank and block.settings.after_asset != blank
              assign after_src = block.settings.after_asset | asset_url
            endif
            assign room = block.settings.room | default: 'This room'
          -%}
          {%- if before_src != blank and after_src != blank -%}
            <figure class="ba" data-ba {{ block.shopify_attributes }}>
              <div class="ba-stage">
                {% comment %} After sits underneath; the before layer is clipped by the handle. {% endcomment %}
                <img class="ba-img ba-after" src="{{ after_src }}" alt="{{ room | escape }}, after {{ section.settings.service_word | escape }}" loading="lazy" decoding="async" width="1600" height="1200">
                <div class="ba-clip" data-ba-clip>
                  <img class="ba-img ba-before" src="{{ before_src }}" alt="{{ room | escape }}, before {{ section.settings.service_word | escape }}" loading="lazy" decoding="async" width="1600" height="1200">
                </div>

                <span class="ba-pill ba-pill-b" aria-hidden="true">{{ section.settings.before_label | default: 'Before' }}</span>
                <span class="ba-pill ba-pill-a" aria-hidden="true">{{ section.settings.after_label | default: 'After' }}</span>

                <div class="ba-handle" data-ba-handle aria-hidden="true">
                  <span class="ba-line"></span>
                  <span class="ba-grip">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 3 12l6 6"/><path d="m15 6 6 6-6 6"/></svg>
                  </span>
                </div>

                {% comment %}
                  The range IS the control, not a mirror of one: keyboard and screen
                  reader users drag the same value everyone else drags, and it keeps
                  working with no JS at all.
                {% endcomment %}
                <label class="ba-ctl">
                  <span class="ba-vh">{{ room }} — drag to reveal the before photo</span>
                  <input class="ba-range" type="range" min="0" max="100" value="{{ block.settings.start | default: 50 }}" step="1" data-ba-range>
                </label>
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption>{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Before / after slider",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drag to compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same room, before and after." },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "text", "id": "service_word", "label": "Service word (used in alt text)", "default": "staging" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Before / after pair",
      "settings": [
        { "type": "text", "id": "room", "label": "Room name", "default": "Living room" },
        { "type": "image_picker", "id": "before_image", "label": "Before image" },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "text", "id": "before_asset", "label": "Before asset filename", "info": "Used only when no Before image is picked. e.g. ba-stage-bedroom-before.jpg" },
        { "type": "text", "id": "after_asset", "label": "After asset filename", "info": "Used only when no After image is picked. e.g. ba-stage-bedroom-after.jpg" },
        { "type": "range", "id": "start", "label": "Starting handle position", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Before / after slider" }]
}
{% endschema %}
