<div class="doors" id="segments">
  {%- for block in section.blocks -%}
    <a class="door" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      <div class="door-photo">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.tag | escape }}" loading="lazy" width="1200" height="800">
        {%- elsif block.settings.image_url != blank -%}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.tag | escape }}" loading="lazy" width="1200" height="800">
        {%- endif -%}
        <span class="tag">{{ block.settings.tag }}</span>
      </div>
      <div class="door-body">
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
        {%- if block.settings.quote != blank -%}
        <div class="door-quote">
          <p class="q">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <cite><b>{{ block.settings.quote_name }}</b> · {{ block.settings.quote_role }}</cite>
        </div>
        {%- endif -%}
        <span class="go"><span>{{ block.settings.link_label }}</span></span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Audience doors",
  "settings": [],
  "blocks": [
    {
      "type": "door",
      "name": "Door",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_url", "label": "Photo URL (fallback)", "info": "Used only when no photo is picked" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "For real estate agents" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your listing goes live Thursday, and the rooms are empty." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Staging, floor plans, and photo edits in one order, back in 24 to 48 hours. Listing bundles from $349." },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "quote_name", "label": "Quote name" },
        { "type": "text", "id": "quote_role", "label": "Quote role" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See what we do for agents" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Audience doors",
