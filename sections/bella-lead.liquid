<section class="lead-band" id="FreeSample">
  <div class="lb-in">
    <div class="lb-copy">
      <span class="micro">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="lb-points">
        <span>✓ Watermark-free</span>
        <span>✓ Back within 24 hours</span>
        <span>✓ No credit card</span>
      </div>
    </div>
    {%- form 'contact', id: 'LeadForm', class: 'lb-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="lb-ok">✓ You're in — check your inbox and reply to our email with your photo or plans.</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="Work email" required aria-label="Work email">
        <select name="contact[role]" required aria-label="I'm a…">
          <option value="" disabled selected>I'm a…</option>
          <option value="agent">Real estate agent</option>
          <option value="broker">Broker / team lead</option>
          <option value="builder">Home builder / developer</option>
          <option value="investor">Investor / flipper</option>
          <option value="photographer">Real estate photographer</option>
        </select>
        <input type="hidden" name="contact[body]" value="Partner pricing request from: {{ article.title | default: page.title | default: page_title | escape }}">
        <button type="submit">{{ section.settings.button }}</button>
        <small>{{ section.settings.fine }}</small>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Lead capture band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For real estate pros & builders" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it on your own listing — free." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We partner with hundreds of brokerages across the US and Canada, at pricing built for volume rather than one-off orders. Leave your email and we'll send your team's partner pricing." },
    { "type": "text", "id": "button", "label": "Button", "default": "Send me partner pricing →" },
    { "type": "text", "id": "fine", "label": "Fine print", "default": "For real estate professionals, builders and developers. We'll never share your email." }
  ],
  "presets": [{ "name": "Lead capture band" }]
}
{% endschema %}
