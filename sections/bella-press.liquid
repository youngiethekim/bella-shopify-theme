<section class="press" id="press">
  <div class="head">
    <span class="micro">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="press-grid">
    {%- for block in section.blocks -%}
      <a class="pc" href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        <figure>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1200" height="800">
          {%- elsif block.settings.image_url != blank -%}
            <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1200" height="800">
          {%- endif -%}
        </figure>
        <div class="body">
          <div class="out">{{ block.settings.outlet }}</div>
          <div class="t">{{ block.settings.title }}</div>
          <div class="by">{{ block.settings.byline }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.more != blank -%}
    <div class="press-more">{{ section.settings.more }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Press",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the press" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reporters have been checking our work since 2020." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Fortune, The Globe and Mail, Inman and the Miami Herald have all looked at what we make. Every link below goes to the original article." },
    { "type": "text", "id": "more", "label": "Also covered by", "default": "Also covered by Geek Estate · Real Estate Magazine · ValiantCEO · Medium · Storeys · Vancouver Awesome · Bob Vila" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "outlet", "label": "Outlet", "default": "FORTUNE" },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "text", "id": "byline", "label": "Byline" },
        { "type": "url", "id": "link", "label": "Article link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Press",
      "blocks": [
        { "type": "article", "settings": {
          "image_url": "https://www.bellavirtual.com/cdn/shop/files/FORTUNE.jpg?width=800",
          "outlet": "FORTUNE",
          "title": "Coronavirus has shut down open houses, but virtual staging and 3D walkthroughs are saving the day",
          "byline": "by David Z. Morris",
          "link": "https://fortune.com/2020/07/05/virtual-home-staging-coronavirus-real-estate-house-hunting-apartments/" } },
        { "type": "article", "settings": {
          "image_url": "https://www.bellavirtual.com/cdn/shop/files/globe_and_mail.jpg?width=800",
          "outlet": "THE GLOBE AND MAIL",
          "title": "In some real estate listings, it's hard to see what's real",
          "byline": "by Shane Digman",
          "link": "https://www.theglobeandmail.com/real-estate/article-in-some-real-estate-listings-its-hard-to-see-whats-real/" } },
        { "type": "article", "settings": {
          "image_url": "https://www.bellavirtual.com/cdn/shop/files/Bella_Virtual_Staging_Edit_3.png?width=800",
          "outlet": "INMAN",
          "title": "Is it Real or BellaStaging? - Inman.com Tech Review",
          "byline": "by Craig Rowe",
          "link": "https://www.inman.com/2024/02/09/is-it-real-or-is-it-bella-staging-tech-review/" } },
        { "type": "article", "settings": {
          "image_url": "https://www.bellavirtual.com/cdn/shop/files/Bella_Virtual_Staging_Miami_Herald.jpg?width=800",
          "outlet": "MIAMI HERALD",
          "title": "Miami Digital Staging to Sell",
          "byline": "by Michael Butler",
          "link": "https://www.miamiherald.com/news/business/real-estate-news/article277824868.html" } }
      ]
    }
  ]
}
{% endschema %}
