<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
{% include 'booster-seo' %}
  {% include 'shop-sheriff-amp' %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FDFCFA">
  {%- comment -%} Every collection renders the same blocks from templates/collection.json, so they all canonicalise to one URL. Drop this branch if collections get per-collection content. {%- endcomment -%}
  {%- if request.page_type == 'collection' -%}
    <link rel="canonical" href="{{ shop.secure_url }}/collections/our-services">
  {%- else -%}
    <link rel="canonical" href="{{ canonical_url }}">
  {%- endif -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- assign vs_home_price = all_products['virtual-staging'].price_min | money_without_trailing_zeros | append: ' ' | append: cart.currency.iso_code -%}
  {%- if request.page_type == 'index' -%}
  {% comment %}<title>Virtual Staging for Real Estate — From {{ vs_home_price }} a Photo | Bella</title>{% endcomment %}
  {% comment %}<meta name="description" content="Designer virtual staging for real estate — MLS-ready in 24–48 hours, from {{ vs_home_price }} a photo. Plus 3D rendering, floor plans, photo editing and 360 tours. Rated 4.9 on Google.">{% endcomment %}
  {%- else -%}
  {% comment %}<title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains 'Bella' %} &ndash; Bella{% endunless -%}
  </title>{% endcomment %}

  {% if page_description %}
    {% comment %}<meta name="description" content="Designer virtual staging for real estate — MLS-ready in 24–48 hours, from {{ vs_home_price }} a photo. Plus 3D rendering, floor plans, photo editing and 360 tours. Rated 4.9 on Google.">{% endcomment %}
  {% endif %}
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

  {{ 'bella.css' | asset_url | stylesheet_tag }}
  {{ 'bella-pdp.css' | asset_url | stylesheet_tag }}

  {% render 'bella-seo' %}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  {% render 'bella-icons' %}

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- unless template.name == 'product' or template.name == 'cart' -%}
    <a class="bb-float" id="BbFloat" href="{{ '/collections/our-services' }}">
      <span class="bf-txt">Order now</span>
      <span class="bf-sub">From {{ all_products['virtual-staging'].price_min | money_without_trailing_zeros | append: ' ' | append: cart.currency.iso_code }} · 24–48 h delivery</span>
    </a>
  {%- endunless -%}

  {%- if settings.enable_assistant -%}
    {% render 'bella-assistant' %}
  {%- endif -%}

  {%- if settings.enable_freestage_popup and template.name == 'index' -%}
    {% render 'bella-freestage' %}
  {%- endif -%}

  <script src="{{ 'bella.js' | asset_url }}" defer></script>
  <script src="{{ 'bella-pdp.js' | asset_url }}" defer></script>
</body>
</html>
