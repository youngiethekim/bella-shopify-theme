<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FDFCFA">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains 'Bella' %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

  {{ 'bella.css' | asset_url | stylesheet_tag }}
  {{ 'bella-pdp.css' | asset_url | stylesheet_tag }}

  {% render 'bella-seo' %}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  {% render 'bella-icons' %}

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.enable_assistant -%}
    {% render 'bella-assistant' %}
  {%- endif -%}

  {%- if settings.enable_freestage_popup and template.name == 'index' -%}
    {% render 'bella-freestage' %}
  {%- endif -%}

  <script src="{{ 'bella.js' | asset_url }}" defer></script>
  <script src="{{ 'bella-pdp.js' | asset_url }}" defer></script>
</body>
</html>
