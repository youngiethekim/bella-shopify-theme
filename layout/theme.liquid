<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FDFCFA">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains 'Bella' %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'bella-fonts' %}

  {{ 'bella.css' | asset_url | stylesheet_tag }}
  {%- comment -%}
    Despite the name, bella-pdp.css is a second site-wide stylesheet: it carries
    .bb-float, .art-cta and the location, resources, portfolio, palette and
    timeline sections. It is not safe to load conditionally.
  {%- endcomment -%}
  {{ 'bella-pdp.css' | asset_url | stylesheet_tag }}
  {%- comment -%} Last, so its focus rules win over the outline:none above. {%- endcomment -%}
  {{ 'bella-a11y.css' | asset_url | stylesheet_tag }}

  {% render 'bella-seo' %}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {% render 'bella-icons' %}

  {% sections 'header-group' %}

  {%- comment -%} tabindex allows the skip link to actually move focus here, not just scroll. {%- endcomment -%}
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- unless template.name == 'product' or template.name == 'cart' -%}
    {%- capture bb_float_price -%}
      {% render 'bella-price', product: settings.float_product, handle: 'virtual-staging', prefix: 'From' %}
    {%- endcapture -%}
    {%- assign bb_float_price = bb_float_price | strip -%}
    <a class="bb-float" id="BbFloat" href="{{ settings.float_link | default: routes.all_products_collection_url }}">
      <span class="bf-txt">{{ settings.float_label | default: 'Order now' }}</span>
      <span class="bf-sub">{% if bb_float_price != blank %}{{ bb_float_price }} · {% endif %}{{ settings.float_note | default: '24–48 h delivery' }}</span>
    </a>
  {%- endunless -%}

  {%- if settings.enable_assistant -%}
    {% render 'bella-assistant' %}
  {%- endif -%}

  {%- if settings.enable_freestage_popup and template.name == 'index' -%}
    {% render 'bella-freestage' %}
  {%- endif -%}

  <script src="{{ 'bella.js' | asset_url }}" defer></script>
  {%- comment -%}
    bella-pdp.js only ever touches the product gallery, the buy box and the
    lookbook, so other pages were downloading 13 KB to do nothing. The lookbook
    section loads it for itself when it appears off a product page.
  {%- endcomment -%}
  {%- if template.name == 'product' -%}
    <script src="{{ 'bella-pdp.js' | asset_url }}" defer></script>
  {%- endif -%}
</body>
</html>
